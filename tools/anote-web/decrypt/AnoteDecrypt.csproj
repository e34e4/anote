<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>AnoteDecrypt</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\src\SilentNotes.AllPlatforms\Crypto\**\*.cs" Link="Crypto\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="..\..\..\src\SilentNotes.AllPlatforms\Crypto\NamespaceDoc.cs" />
    <Compile Include="..\..\..\src\SilentNotes.AllPlatforms\Workers\CompressUtils.cs" Link="Workers\CompressUtils.cs" />
    <Compile Include="..\..\..\src\SilentNotes.AllPlatforms\Workers\ByteArrayExtensions.cs" Link="Workers\ByteArrayExtensions.cs" />
    <Compile Include="..\..\..\src\VanillaCloudStorageClient\SecureStringExtensions.cs" Link="Vanilla\SecureStringExtensions.cs" />
  </ItemGroup>
</Project>
