@using MudBlazor
@using SilentNotes.Services
@using SilentNotes.ViewModels
@implements IDisposable

@inject ILanguageService LanguageService
@inject IMessengerService MessengerService
@inject IWebdavQuickSaveService WebdavQuickSaveService
@inject IFeedbackService FeedbackService

<style type="text/css">
	.rec-root {
		background-color: #000000;
		min-height: calc(100vh - 208px);
		padding: 10px;
		color: #ffffff;
	}
	.rec-sections {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
		margin-bottom: 10px;
	}
	.rec-section-btn {
		border: 1px solid #2b2b2b;
		border-radius: 10px;
		background-color: #000000;
		color: #cccccc;
		font-size: 0.9rem;
		height: 40px;
		cursor: pointer;
		touch-action: manipulation;
	}
	.rec-section-btn.active {
		color: #ffffff;
		border-color: var(--mud-palette-primary);
		background-color: #101010;
	}
	.rec-recorder-card {
		border: 1px solid #2b2b2b;
		border-radius: 14px;
		background-color: #0d0d0d;
		padding: 16px;
		text-align: center;
		margin-bottom: 14px;
	}
	.rec-timer {
		font-size: 2.4rem;
		font-family: ui-monospace, "Cascadia Code", monospace;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		margin: 4px 0 8px 0;
	}
	.rec-timer.active {
		color: #ff5252;
	}
	.rec-status {
		font-size: 0.85rem;
		color: #9e9e9e;
		margin-bottom: 12px;
	}
	.rec-controls {
		display: flex;
		justify-content: center;
		gap: 10px;
		flex-wrap: wrap;
	}
	.rec-btn {
		border: 1px solid #2b2b2b;
		border-radius: 12px;
		background-color: #000000;
		color: #ffffff;
		height: 46px;
		padding: 0 18px;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		touch-action: manipulation;
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.rec-btn:active {
		background-color: #1f1f1f;
	}
	.rec-btn.record {
		border-color: #ff5252;
		color: #ff5252;
	}
	.rec-btn.primary {
		border-color: var(--mud-palette-primary);
		color: var(--mud-palette-primary);
	}
	.rec-list-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 4px 4px 8px 4px;
	}
	.rec-row {
		border: 1px solid #202020;
		border-radius: 12px;
		background-color: #0a0a0a;
		padding: 10px 12px;
		margin-bottom: 8px;
	}
	.rec-row-top {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.rec-row-main {
		flex-grow: 1;
		overflow: hidden;
	}
	.rec-row-title {
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.rec-row-meta {
		font-size: 0.8rem;
		color: #9e9e9e;
		margin-top: 2px;
	}
	.rec-player-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 8px;
		padding-top: 6px;
		border-top: 1px solid #202020;
		font-family: ui-monospace, "Cascadia Code", monospace;
		font-size: 0.85rem;
		color: var(--mud-palette-primary);
	}
</style>

<div class="rec-root">
	<div class="rec-sections">
		<button class="rec-section-btn @(ViewModel.IsAudioSection ? "active" : null)" @onclick="() => ViewModel.ShowAudioCommand.Execute(null)">@LanguageService["rec_audio"]</button>
		<button class="rec-section-btn @(ViewModel.IsScreenSection ? "active" : null)" @onclick="() => ViewModel.ShowScreenCommand.Execute(null)">@LanguageService["rec_screen"]</button>
	</div>

	@if (!ViewModel.IsSupported)
	{
		<MudAlert Severity="Severity.Info" Dense="true">@(ViewModel.IsScreenSection ? LanguageService["rec_screen_not_supported"] : LanguageService["rec_not_supported"])</MudAlert>
	}
	else
	{
		@if (ViewModel.NeedsPermission)
		{
			<MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
				<span>@LanguageService["rec_needs_permission"]</span>
				<MudButton Size="Size.Small" Color="Color.Primary" Class="ml-2" OnClick="GrantPermissionAsync">@LanguageService["rec_grant"]</MudButton>
			</MudAlert>
		}

		<div class="rec-recorder-card">
			<div class="rec-timer @(ViewModel.IsRecording && !ViewModel.IsRecordingPaused ? "active" : null)">
				@(ViewModel.IsRecording ? ViewModel.ElapsedText : "00:00")
			</div>
			<div class="rec-status">
				@if (!ViewModel.IsRecording)
				{
					@(ViewModel.IsScreenSection ? LanguageService["rec_screen_ready"] : LanguageService["rec_ready"])
				}
				else if (ViewModel.IsRecordingPaused)
				{
					@LanguageService["rec_paused"]
				}
				else
				{
					@(ViewModel.IsScreenSection ? LanguageService["rec_screen_recording"] : LanguageService["rec_recording"])
				}
			</div>

			<div class="rec-controls">
				@if (!ViewModel.IsRecording)
				{
					<button class="rec-btn record" @onclick="StartRecordingAsync">
						<MudIcon Icon="@(ViewModel.IsScreenSection ? Icons.Material.Filled.FiberManualRecord : Icons.Material.Filled.FiberManualRecord)" Size="Size.Small" />
						<span>@(ViewModel.IsScreenSection ? LanguageService["rec_screen_start"] : LanguageService["rec_start"])</span>
					</button>
				}
				else
				{
					@if (ViewModel.CanPauseResume)
					{
						<button class="rec-btn" @onclick="() => ViewModel.PauseResumeRecordingCommand.Execute(null)">
							<MudIcon Icon="@(ViewModel.IsRecordingPaused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)" Size="Size.Small" />
							<span>@(ViewModel.IsRecordingPaused ? LanguageService["rec_resume"] : LanguageService["rec_pause"])</span>
						</button>
					}
					<button class="rec-btn primary" @onclick="StopRecordingAsync">
						<MudIcon Icon="@Icons.Material.Filled.Stop" Size="Size.Small" />
						<span>@LanguageService["rec_stop_save"]</span>
					</button>
					<button class="rec-btn" @onclick="() => ViewModel.CancelRecordingCommand.Execute(null)">
						<MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
						<span>@LanguageService["cancel"]</span>
					</button>
				}
			</div>
		</div>

		<div class="rec-list-header">
			<MudText Typo="Typo.caption" Class="mud-text-secondary">@ViewModel.CountText</MudText>
		</div>

		@if (ViewModel.IsEmpty)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@(ViewModel.IsScreenSection ? LanguageService["rec_screen_empty"] : LanguageService["rec_empty"])</MudText>
		}
		else if (ViewModel.HasNoMatches)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["rec_no_matches"]</MudText>
		}
		else
		{
			@foreach (var item in ViewModel.FilteredRecordings)
			{
				<div class="rec-row" @key="item.FileName">
					@if (ViewModel.IsRenaming(item))
					{
						<div class="rec-row-top">
							<MudTextField T="string" @bind-Value="ViewModel.DraftNewName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Immediate="true" />
							<MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small" OnClick="() => ViewModel.SaveRenameCommand.Execute(null)" title="@LanguageService["rec_save_name"]" />
							<MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => ViewModel.CancelRenameCommand.Execute(null)" title="@LanguageService["cancel"]" />
						</div>
					}
					else
					{
						<div class="rec-row-top">
							@if (ViewModel.IsAudioSection)
							{
								<MudIconButton Icon="@(ViewModel.IsItemPlaying(item) ? Icons.Material.Filled.PauseCircleFilled : Icons.Material.Filled.PlayCircleFilled)"
									Color="Color.Primary" Size="Size.Medium"
									OnClick="() => ViewModel.TogglePlayCommand.Execute(item)"
									title="@LanguageService["rec_play"]" />
							}
							else
							{
								<MudIcon Icon="@Icons.Material.Filled.Videocam" Color="Color.Primary" Size="Size.Medium" Class="mr-1" />
							}

							<div class="rec-row-main">
								<div class="rec-row-title">@item.DisplayTitle</div>
								<div class="rec-row-meta">@item.DateText · @item.DurationText · @item.SizeText</div>
							</div>

							<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => ViewModel.StartRenameCommand.Execute(item)" title="@LanguageService["rec_rename"]" />
							<MudIconButton Icon="@Icons.Material.Filled.SaveAlt" Size="Size.Small" OnClick="() => SaveToDeviceAsync(item)" title="@(ViewModel.IsScreenSection ? LanguageService["rec_screen_save_device"] : LanguageService["rec_save_device"])" />
							<MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Success" Size="Size.Small" OnClick="() => SaveToWebdavAsync(item)" title="@LanguageService["webdav_quick_save"]" />
							<MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small" OnClick="() => ShareAsync(item)" title="@LanguageService["share"]" />
							<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => DeleteAsync(item)" title="@LanguageService["rec_delete"]" />
						</div>

						@if (ViewModel.IsItemActiveInPlayer(item))
						{
							<div class="rec-player-bar">
								<span>@ViewModel.PlaybackProgressText</span>
								<MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small" Color="Color.Inherit" OnClick="() => ViewModel.StopPlayCommand.Execute(null)" />
							</div>
						}
					}
				</div>
			}
		}
	}
</div>

@code {
	[Parameter]
	public RecViewModel ViewModel { get; set; }

	protected override void OnInitialized()
	{
		if (ViewModel != null)
			ViewModel.StateChanged += OnViewModelStateChanged;
		MessengerService.Register<AfterResumeMessage>(this, (r, m) => InvokeAsync(() => { ViewModel?.Reload(); StateHasChanged(); }));
	}

	private void OnViewModelStateChanged()
	{
		InvokeAsync(StateHasChanged);
	}

	private async Task GrantPermissionAsync()
	{
		await ViewModel.GrantPermissionAsync();
		StateHasChanged();
	}

	private async Task StartRecordingAsync()
	{
		await ViewModel.StartRecordingAsync();
		StateHasChanged();
	}

	private async Task StopRecordingAsync()
	{
		await ViewModel.StopRecordingAsync();
		StateHasChanged();
	}

	private async Task SaveToDeviceAsync(AudioRecordingItemViewModel item)
	{
		await ViewModel.SaveToDeviceAsync(item);
		StateHasChanged();
	}

	private async Task ShareAsync(AudioRecordingItemViewModel item)
	{
		await ViewModel.ShareAsync(item);
		StateHasChanged();
	}

	private async Task DeleteAsync(AudioRecordingItemViewModel item)
	{
		await ViewModel.DeleteAsync(item);
		StateHasChanged();
	}

	private async Task SaveToWebdavAsync(AudioRecordingItemViewModel item)
	{
		if (item == null)
			return;
		if (!WebdavQuickSaveService.IsConfigured)
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_not_configured"], FeedbackSeverity.Warning);
			return;
		}

		string source = ViewModel.IsScreenSection ? "RecScreen" : "Rec";
		bool ok = await WebdavQuickSaveService.SaveLocalFileAsync(source, item.Model.FilePath);
		if (ok)
			FeedbackService.ShowToast(LanguageService.LoadTextFmt("webdav_quick_saved", WebdavQuickSaveService.LastFileName));
		else
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"] + " — " + WebdavQuickSaveService.LastError, FeedbackSeverity.Warning);
	}

	public void Dispose()
	{
		if (ViewModel != null)
			ViewModel.StateChanged -= OnViewModelStateChanged;
		MessengerService.Unregister<AfterResumeMessage>(this);
	}
}
