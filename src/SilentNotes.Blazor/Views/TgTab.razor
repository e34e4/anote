	}

	private async Task OnMessagesScroll(EventArgs args)
	{
		if (!ViewModel.HasMoreMessages || ViewModel.IsLoadingOlder)
			return;
		try
		{
			bool nearBottom = await JSRuntime.InvokeAsync<bool>(
				"eval",
				"(function(el){ if(!el) return false; return (el.scrollHeight - el.scrollTop - el.clientHeight) < 96; })(document.querySelector('.tg-messages'))");
			if (!nearBottom)
				return;
		}
		catch
		{
			return;
		}

		await ViewModel.LoadOlderMessagesAsync();
		StateHasChanged();
	}

	private async Task CompleteForwardAsync(string chatKey)
	{
		await ViewModel.CompleteForwardAsync(chatKey);
		StateHasChanged();
