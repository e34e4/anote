@using MudBlazor
@using SilentNotes.Models
@using SilentNotes.Services
@using SilentNotes.ViewModels

@inject ILanguageService LanguageService

<style type="text/css">
	.contacts-list {
		overflow-y: auto;
		max-height: calc(100vh - 340px);
	}
	.contact-index {
		grid-area: num;
		color: var(--mud-palette-text-secondary);
		font-variant-numeric: tabular-nums;
		min-width: 2.2rem;
		text-align: right;
	}
	.contact-phone {
		font-family: ui-monospace, "Cascadia Code", monospace;
		text-transform: none;
	}
	.contact-empty-number {
		color: var(--mud-palette-text-secondary);
	}
	.theme-dark .contact-card {
		background-color: #000000;
	}
	.contact-action-btns {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-left: 4px;
	}
	.contact-action-btns .mud-icon-button {
		margin: 0 !important;
		padding: 6px !important;
	}
	.contact-crm {
		border-top: 1px solid var(--mud-palette-lines-default);
		margin-top: 8px;
		padding-top: 8px;
	}
	.contact-follow-up-badge.overdue {
		background-color: #f44336;
		color: #ffffff;
	}
	.contact-interaction-line {
		white-space: pre-wrap;
		word-break: break-word;
	}
</style>

<div class="pa-2">
	@if (!ViewModel.IsEmpty)
	{
		<MudStack Row="true" Spacing="1" Class="mb-2 flex-wrap">
			<MudChip T="string" Variant="Variant.Outlined"
				Color="@(ViewModel.FilterDueFollowUpOnly ? Color.Warning : Color.Default)"
				OnClick="@ToggleDueFollowUpFilter">
				@LanguageService["contact_filter_due_follow_up"]
			</MudChip>
		</MudStack>
	}
	<MudText Typo="Typo.caption" Class="contact-empty-number mb-1">@ViewModel.CountText</MudText>

	@if (ViewModel.IsEmpty)
	{
		<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["contact_empty"]</MudText>
	}
	else if (ViewModel.HasNoMatches)
	{
		<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["contact_no_matches"]</MudText>
	}
	else
	{
		<div class="contacts-list">
			@foreach (var contact in ViewModel.FilteredContacts)
			{
				<MudPaper Elevation="1" Class="pa-2 my-2 contact-card" @key="contact.Id">
					<div class="d-flex align-center">
						<MudText Class="contact-index mr-2">@contact.Index</MudText>
						@if (contact.IsFollowUpDue)
						{
							<MudChip T="string" Size="Size.Small" Class="contact-follow-up-badge overdue mr-2"
							         title="@LanguageService["contact_follow_up_due"]">@LanguageService["contact_follow_up_due"]</MudChip>
						}
						else if (contact.HasNextFollowUp)
						{
							<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-2"
							         title="@LanguageService.LoadTextFmt("contact_next_follow_up", contact.NextFollowUpText)">
								@contact.NextFollowUpText
							</MudChip>
						}
						<MudTextField @bind-Value="contact.Name"
							Variant="Variant.Text" Margin="Margin.Dense" Class="flex-grow-1"
							Placeholder="@LanguageService["contact_name"]" />
						<MudStack Row="true" Spacing="0" Class="flex-shrink-0">
							<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => ViewModel.StartEditNumbersCommand.Execute(contact))" title="@LanguageService["contact_edit"]" />
							<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => ViewModel.DeleteCommand.Execute(contact))" title="@LanguageService["contact_delete"]" />
						</MudStack>
					</div>

					<div class="d-flex align-center pl-2 flex-wrap">
						@if (ViewModel.IsEditingNumbersOf(contact))
						{
							<MudTextField @bind-Value="ViewModel.DraftNumbers"
								Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
								Placeholder="@LanguageService["contact_numbers"]" />
							<MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Primary" OnClick="@(() => ViewModel.SaveNumbersCommand.Execute(null))" title="@LanguageService["contact_save"]" />
							<MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => ViewModel.CancelEditNumbersCommand.Execute(null))" title="@LanguageService["cancel"]" />
						}
						else if (contact.Phones.Count > 0)
						{
							@foreach (var phone in contact.Phones)
							{
								<div class="d-flex align-center mr-3">
									<MudButton Variant="Variant.Text" Size="Size.Small" Class="contact-phone"
										OnClick="@(() => ViewModel.CopyCommand.Execute(phone))" title="@LanguageService["contact_copy"]">@phone</MudButton>
									<div class="contact-action-btns">
										<MudIconButton Icon="@Icons.Material.Filled.Phone" Size="Size.Small" OnClick="@(() => ViewModel.CallCommand.Execute(phone))" title="@LanguageService["contact_call"]" />
										<MudIconButton Icon="@Icons.Material.Filled.Message" Size="Size.Small" OnClick="@(() => ViewModel.SmsCommand.Execute(phone))" title="@LanguageService["contact_sms"]" />
										<MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" OnClick="@(() => ViewModel.TelegramCommand.Execute(phone))" title="@LanguageService["contact_telegram"]" />
									</div>
								</div>
							}
						}
						else
						{
							<MudText Class="contact-empty-number">@LanguageService["contact_no_number"]</MudText>
						}
					</div>

					<div class="contact-crm pl-2">
						<MudText Typo="Typo.caption" Class="contact-empty-number mb-1">@LanguageService["contact_notes"]</MudText>
						<MudTextField @bind-Value="contact.Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" AutoGrow="true"
							Placeholder="@LanguageService["contact_notes_placeholder"]" Class="mb-2" />

						<MudText Typo="Typo.caption" Class="contact-empty-number mb-1">@LanguageService["contact_follow_up_interval"]</MudText>
						<MudSelect T="int" @bind-Value="contact.FollowUpIntervalDays" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-2">
							@foreach (var days in ContactsViewModel.FollowUpIntervalChoices)
							{
								<MudSelectItem T="int" Value="days">@ViewModel.FormatFollowUpInterval(days)</MudSelectItem>
							}
						</MudSelect>

						<MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-2">
							<MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
								OnClick="@(() => ViewModel.MarkContactedCommand.Execute(contact))">@LanguageService["contact_mark_contacted"]</MudButton>
							<MudTextField @bind-Value="contact.DraftLogSummary" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
								Placeholder="@LanguageService["contact_log_summary_placeholder"]" />
							<MudButton Variant="Variant.Outlined" Size="Size.Small"
								OnClick="@(() => ViewModel.LogInteractionCommand.Execute(contact))">@LanguageService["contact_log_interaction"]</MudButton>
						</MudStack>

						@if (contact.RecentInteractionLog.Count > 0)
						{
							<MudText Typo="Typo.caption" Class="contact-empty-number mb-1">@LanguageService["contact_interaction_log"]</MudText>
							@foreach (var entry in contact.RecentInteractionLog)
							{
								<MudText Typo="Typo.caption" Class="contact-interaction-line mb-1">
									@entry.Utc.ToLocalTime().ToString("g") — @(string.IsNullOrWhiteSpace(entry.Summary) ? LanguageService["contact_interaction_contacted"] : entry.Summary)
								</MudText>
							}
						}
					</div>
				</MudPaper>
			}
		</div>
	}
</div>

@code {
	/// <summary>
	/// Gets or sets the view model of the phone tab.
	/// </summary>
	[Parameter]
	public ContactsViewModel ViewModel { get; set; }

	private void ToggleDueFollowUpFilter()
	{
		ViewModel.FilterDueFollowUpOnly = !ViewModel.FilterDueFollowUpOnly;
	}
}
