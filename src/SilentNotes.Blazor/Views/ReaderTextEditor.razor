	private async Task CutRowAsync()
	{
		var line = await GetCurrentLineAsync();
		PushHistoryBeforeMutation();
		await ClipboardService.SetTextAsync(line.Text ?? string.Empty);
		int end = line.End;
		if (end < (_text?.Length ?? 0) && _text[end] == '\n')
			end++;
		else if (line.Start > 0 && end == (_text?.Length ?? 0))
		{
			line = new Sel { Start = line.Start > 0 ? line.Start - 1 : line.Start, End = end, Text = line.Text };
		}
		string next = await ReplaceRangeAsync(line.Start, end, string.Empty);
		await ApplyExternalTextAsync(next, pushHistory: true);
	}

	private async Task UndoAsync()
	{
		if (_historyIndex <= 0)
			return;
		_historyIndex--;
		await ApplyHistoryStateAsync(_history[_historyIndex]);
	}

	private async Task RedoAsync()
	{
		if (_historyIndex >= _history.Count - 1)
			return;
		_historyIndex++;
		await ApplyHistoryStateAsync(_history[_historyIndex]);
	}

	private async Task ApplyHistoryStateAsync(string text)
	{
		_applyingHistory = true;
		try
		{
			_text = text ?? string.Empty;
			_dirty = true;
			await SetTextareaValueAsync(_text);
			RefreshHighlightImmediate();
			await PushOverlayAsync();
			await PushStatsAsync();
			await RefreshActiveLineAsync();
		}
		finally
		{
			_applyingHistory = false;
		}
	}

