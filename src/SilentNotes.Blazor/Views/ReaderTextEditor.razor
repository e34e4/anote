@using System.IO
@using System.Text
@using System.Text.RegularExpressions
@using MudBlazor
@using SilentNotes.Models
@using SilentNotes.Services
@using SilentNotes.Workers
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject ISettingsService SettingsService
@inject IFilePickerService FilePickerService
@inject IClipboardService ClipboardService
@inject IDocumentReaderService DocumentReaderService
@inject ILanguageService LanguageService
@inject IFeedbackService FeedbackService

<style type="text/css">
	.rte-root {
		display: flex;
		flex-direction: column;
		min-height: calc(100vh - 260px);
	}
	.rte-body {
		display: flex;
		flex: 1 1 auto;
		min-height: 240px;
		border: 1px solid #202020;
		border-radius: 6px;
		overflow: hidden;
		background: #050505;
		position: relative;
	}
	.rte-gutter {
		flex: 0 0 auto;
		min-width: 2.6rem;
		padding: 8px 6px 8px 8px;
		text-align: right;
		font-family: var(--rte-font, ui-monospace, "Cascadia Code", "Noto Sans Mono", monospace);
		font-size: 0.9rem;
		line-height: 1.45;
		color: #666;
		background: #0a0a0a;
		border-right: 1px solid #1a1a1a;
		overflow: hidden;
		user-select: none;
		white-space: pre;
		z-index: 2;
	}
	.rte-surface {
		flex: 1 1 auto;
		position: relative;
		overflow: hidden;
		min-width: 0;
	}
	.rte-active-line {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 1.45em;
		background: rgba(80, 160, 80, 0.12);
		pointer-events: none !important;
		z-index: 0;
		display: none;
	}
	.rte-highlight,
	.rte-textarea {
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 8px;
		border: 0;
		outline: none;
		resize: none;
		font-family: var(--rte-font, ui-monospace, "Cascadia Code", "Noto Sans Mono", monospace);
		font-size: 0.9rem;
		line-height: 1.45;
		tab-size: 4;
		white-space: pre;
		overflow: auto;
		box-sizing: border-box;
		background: transparent;
	}
	.rte-highlight.wrap,
	.rte-textarea.wrap {
		white-space: pre-wrap;
		word-break: break-word;
		overflow-wrap: anywhere;
	}
	.rte-highlight {
		color: #e8e8e8;
		pointer-events: none !important;
		z-index: 1;
	}
	.rte-gutter {
		pointer-events: none !important;
	}
	.rte-textarea {
		z-index: 3;
		/* Near-invisible ink keeps Android WebView hit-testing/caret placement working. */
		color: rgba(232, 232, 232, 0.01);
		caret-color: #ffffff;
		-webkit-text-fill-color: rgba(232, 232, 232, 0.01);
	}
	.rte-textarea::selection {
		background: rgba(144, 238, 144, 0.38);
		color: transparent;
	}
	.rte-textarea::-moz-selection {
		background: rgba(144, 238, 144, 0.38);
		color: transparent;
	}
	.rte-space {
		position: relative;
	}
	.rte-space::after {
		content: "·";
		position: absolute;
		left: 0;
		top: 0;
		opacity: 0.72;
		color: #b0b0b0;
		pointer-events: none;
	}
	.rte-tab {
		position: relative;
	}
	.rte-tab::after {
		content: "→";
		position: absolute;
		left: 0;
		top: 0;
		opacity: 0.55;
		color: #a8a8a8;
		pointer-events: none;
	}
	.rte-eol {
		display: inline-block;
		width: 0;
		overflow: visible;
		color: #9ccc65;
		opacity: 0.9;
		font-size: 0.85em;
		vertical-align: baseline;
		pointer-events: none;
	}
	.rte-keyword { color: #c792ea; }
	.rte-string { color: #c3e88d; }
	.rte-comment { color: #697098; font-style: italic; }
	.rte-number { color: #f78c6c; }
	.rte-tag { color: #82aaff; }
	.rte-stats {
		font-family: ui-monospace, "Cascadia Code", "Noto Sans Mono", monospace;
		font-size: 0.72rem;
		line-height: 1.3;
		color: #9e9e9e;
		padding: 6px 4px 0 4px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		border-top: 1px solid #202020;
		margin-top: 8px;
		user-select: none;
	}
	.rte-toolbar {
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 8px 2px 0 2px;
		flex-wrap: wrap;
		border-top: none;
		margin-top: 2px;
	}
	.rte-toolbar-btn.mud-icon-button {
		width: 48px !important;
		height: 48px !important;
		padding: 8px !important;
	}
	.rte-toolbar-btn.mud-icon-button .mud-icon-root {
		font-size: 1.85rem !important;
	}
	.rte-toolbar-btn.rte-flash .mud-icon-root {
		color: #7cfc00 !important;
	}
	.rte-panel {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		padding: 8px 2px 0 2px;
	}
	.rte-panel .mud-input-control { flex: 1 1 140px; min-width: 120px; }
	.rte-preview-overlay {
		position: fixed;
		inset: 0;
		z-index: 1200;
		background: rgba(0,0,0,0.72);
		display: flex;
		flex-direction: column;
		padding: 12px;
	}
	.rte-preview-panel {
		flex: 1 1 auto;
		background: #111;
		border: 1px solid #333;
		border-radius: 8px;
		overflow: auto;
		padding: 12px;
		color: #e8e8e8;
	}
	.rte-preview-table {
		border-collapse: collapse;
		width: 100%;
		font-size: 0.85rem;
	}
	.rte-preview-table th,
	.rte-preview-table td {
		border: 1px solid #333;
		padding: 4px 8px;
		text-align: left;
	}
	.rte-preview-table th {
		background: #1a1a1a;
		color: var(--mud-palette-primary);
	}
	.rte-preview-code {
		background: #1a1a1a;
		padding: 8px;
		border-radius: 4px;
		overflow: auto;
	}
	.rte-preview-panel img { max-width: 100%; height: auto; }
	.rte-preview-panel a { color: #82aaff; }
</style>

@if (!string.IsNullOrEmpty(_fontFaceCss))
{
	<style type="text/css">@((MarkupString)_fontFaceCss)</style>
}

<div class="rte-root" style="@_rootStyle">
	<div class="rte-body">
		<pre @ref="_gutterRef" class="rte-gutter"></pre>
		<div class="rte-surface">
			<div @ref="_activeLineRef" class="rte-active-line"></div>
			<pre @ref="_highlightRef" class="rte-highlight @(_wordWrap ? "wrap" : null)"></pre>
			<textarea @ref="_textareaRef"
				class="rte-textarea @(_wordWrap ? "wrap" : null)"
				spellcheck="false"
				autocapitalize="off"
				autocomplete="off"
				autocorrect="off"
				@oninput="OnInput"
				@onblur="OnBlurAsync"></textarea>
		</div>
	</div>

	<div @ref="_statsRef" class="rte-stats" title="@_statsText">@_statsText</div>

	<div class="rte-toolbar">
		@ToolbarButton("copy", Icons.Material.Filled.ContentCopy, LanguageService["reader_editor_copy"], CopyAsync)
		@ToolbarButton("paste", Icons.Material.Filled.ContentPaste, LanguageService["reader_editor_paste"], PasteAsync)
		@ToolbarButton("cut", Icons.Material.Filled.ContentCut, LanguageService["reader_editor_cut"], CutAsync)
		@ToolbarButton("selectall", Icons.Material.Filled.SelectAll, LanguageService["reader_editor_select_all"], SelectAllAsync)
		@ToolbarButton("gotoend", Icons.Material.Filled.VerticalAlignBottom, LanguageService["reader_editor_goto_end"], GoToEndAsync)
		@ToolbarButton("gotostart", Icons.Material.Filled.VerticalAlignTop, LanguageService["reader_editor_goto_start"], GoToStartAsync)
		@ToolbarButton("copyrow", Icons.Material.Filled.CopyAll, LanguageService["reader_editor_copy_row"], CopyRowAsync)
		@ToolbarButton("cutrow", Icons.Material.Filled.PlaylistRemove, LanguageService["reader_editor_cut_row"], CutRowAsync)
	</div>

	<div class="rte-toolbar">
		@ToolbarButton("undo", Icons.Material.Filled.Undo, LanguageService["reader_editor_undo"], UndoAsync)
		@ToolbarButton("redo", Icons.Material.Filled.Redo, LanguageService["reader_editor_redo"], RedoAsync)
		@ToolbarButton("save", Icons.Material.Filled.Save, LanguageService["reader_editor_save"], SaveAsync)
		@ToolbarButton("clear", Icons.Material.Filled.DeleteSweep, LanguageService["reader_editor_clear_all"], ClearAllAsync)
		@ToolbarButton("find", Icons.Material.Filled.Search, LanguageService["reader_editor_find"], ToggleFindAsync)
		@ToolbarButton("replace", Icons.Material.Filled.FindReplace, LanguageService["reader_editor_replace"], ToggleReplaceAsync)
		@ToolbarButton("gotoline", Icons.Material.Filled.FormatListNumbered, LanguageService["reader_editor_goto_line"], ToggleGoToLineAsync)
		@ToolbarButton("dupline", Icons.Material.Filled.ControlPointDuplicate, LanguageService["reader_editor_dup_line"], DuplicateLineAsync)
	</div>

	<div class="rte-toolbar">
		@ToolbarButton("left", Icons.Material.Filled.ArrowBack, LanguageService["reader_editor_key_left"], () => MoveCaretAsync("left"))
		@ToolbarButton("right", Icons.Material.Filled.ArrowForward, LanguageService["reader_editor_key_right"], () => MoveCaretAsync("right"))
		@ToolbarButton("up", Icons.Material.Filled.ArrowUpward, LanguageService["reader_editor_key_up"], () => MoveCaretAsync("up"))
		@ToolbarButton("down", Icons.Material.Filled.ArrowDownward, LanguageService["reader_editor_key_down"], () => MoveCaretAsync("down"))
		@ToolbarButton("space", Icons.Material.Filled.SpaceBar, LanguageService["reader_editor_key_space"], () => InsertKeyAsync(" "))
		@ToolbarButton("tab", Icons.Material.Filled.KeyboardTab, LanguageService["reader_editor_key_tab"], () => InsertKeyAsync("\t"))
		@ToolbarButton("enter", Icons.Material.Filled.KeyboardReturn, LanguageService["reader_editor_key_enter"], () => InsertKeyAsync("\n"))
		@ToolbarButton("lineend", Icons.Material.Filled.LastPage, LanguageService["reader_editor_key_end"], GoToLineEndAsync)
	</div>

	@if (_showFind)
	{
		<div class="rte-panel">
			<MudTextField @bind-Value="_findQuery" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined"
				Placeholder="@LanguageService["reader_editor_find_ph"]" />
			<MudCheckBox @bind-Value="_findRegex" Dense="true" Color="Color.Primary">@LanguageService["reader_editor_regex"]</MudCheckBox>
			<MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="FindNextAsync">@LanguageService["reader_editor_find_next"]</MudButton>
		</div>
	}

	@if (_showReplace)
	{
		<div class="rte-panel">
			<MudTextField @bind-Value="_replaceFind" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined"
				Placeholder="@LanguageService["reader_editor_replace_find_ph"]" />
			<MudTextField @bind-Value="_replaceWith" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined"
				Placeholder="@LanguageService["reader_editor_replace_with_ph"]" />
			<MudCheckBox @bind-Value="_replaceRegex" Dense="true" Color="Color.Primary">@LanguageService["reader_editor_regex"]</MudCheckBox>
			<MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReplaceOneAsync">@LanguageService["reader_editor_replace_one"]</MudButton>
			<MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="ReplaceAllAsync">@LanguageService["reader_editor_replace_all"]</MudButton>
		</div>
	}

	@if (_showGoToLine)
	{
		<div class="rte-panel">
			<MudNumericField @bind-Value="_goToLineNumber" Min="1" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:120px"
				Placeholder="@LanguageService["reader_editor_goto_line_ph"]" />
			<MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToLineAsync">@LanguageService["reader_editor_goto_line_go"]</MudButton>
		</div>
	}
</div>

@if (_previewOpen)
{
	<div class="rte-preview-overlay">
		<div class="d-flex align-center mb-2" style="gap:8px;">
			<MudText Typo="Typo.subtitle1">@LanguageService["reader_editor_preview"]</MudText>
			<span style="flex:1"></span>
			<MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Inherit" OnClick="ClosePreview" />
		</div>
		<div class="rte-preview-panel">@((MarkupString)_previewHtml)</div>
	</div>
}

@code {
	private const int MaxHistory = 50;
	private static readonly TimeSpan FlashDuration = TimeSpan.FromSeconds(10);

	private ElementReference _textareaRef;
	private ElementReference _highlightRef;
	private ElementReference _gutterRef;
	private ElementReference _activeLineRef;
	private ElementReference _statsRef;
	private IJSObjectReference _module;
	private string _text = string.Empty;
	private string _loadedPath;
	private string _highlightHtml = string.Empty;
	private string _lineNumbers = "1";
	private string _statsText = "CH 0  LN 0  BL 0  WO 0  ENC UTF-8";
	private string _encodingLabel = "UTF-8";
	private string _language;
	private bool _wordWrap = true;
	private bool _dirty;
	private bool _canSave;
	private bool _previewOpen;
	private string _previewHtml = string.Empty;
	private string _fontFaceCss = string.Empty;
	private string _fontFamilyCss = string.Empty;
	private string _fontDisplayName = "System";
	private string _rootStyle = string.Empty;
	private CancellationTokenSource _highlightCts;
	private CancellationTokenSource _historyCts;
	private ReaderPreviewRenderer.PreviewKind _previewKind;
	private readonly List<string> _history = new List<string>();
	private int _historyIndex = -1;
	private bool _applyingHistory;
	private readonly Dictionary<string, DateTime> _flashUntil = new Dictionary<string, DateTime>(StringComparer.Ordinal);
	private CancellationTokenSource _flashCts;

	private bool _showFind;
	private bool _showReplace;
	private bool _showGoToLine;
	private string _findQuery = string.Empty;
	private bool _findRegex;
	private string _replaceFind = string.Empty;
	private string _replaceWith = string.Empty;
	private bool _replaceRegex;
	private int _goToLineNumber = 1;
	private bool _shouldRender = true;
	private bool _listenersAttached;
	private bool _restoreCaret;
	private int _restoreCaretStart;
	private int _restoreCaretEnd;
	private double _restoreScrollTop;

	[Parameter]
	public DocumentContentModel Document { get; set; }

	[Parameter]
	public EventCallback SettingsChanged { get; set; }

	public string FontMenuLabel => LanguageService.LoadTextFmt("reader_editor_font_label", _fontDisplayName);

	public bool WordWrap => _wordWrap;

	public bool CanPreview => _previewKind != ReaderPreviewRenderer.PreviewKind.None;

	protected override bool ShouldRender()
	{
		if (!_shouldRender)
			return false;
		_shouldRender = false;
		return true;
	}

	private async Task RequestRenderAsync()
	{
		await CaptureCaretAsync();
		_shouldRender = true;
		StateHasChanged();
	}

	private void RequestRender()
	{
		_ = RequestRenderAsync();
	}

	private RenderFragment ToolbarButton(string id, string icon, string title, Func<Task> action) => __builder =>
	{
		bool flash = IsFlashing(id);
		__builder.OpenComponent<MudIconButton>(0);
		__builder.AddAttribute(1, "Class", flash ? "rte-toolbar-btn rte-flash" : "rte-toolbar-btn");
		__builder.AddAttribute(2, "Icon", icon);
		__builder.AddAttribute(3, "Size", Size.Medium);
		__builder.AddAttribute(4, "Color", flash ? Color.Success : Color.Inherit);
		__builder.AddAttribute(5, "title", title);
		// MudIconButton.OnClick is EventCallback<MouseEventArgs>; a non-generic EventCallback throws InvalidCastException.
		__builder.AddAttribute(6, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, async (MouseEventArgs _) =>
		{
			await FlashButtonAsync(id);
			await action();
		}));
		__builder.CloseComponent();
	};

	protected override async Task OnParametersSetAsync()
	{
		string path = Document?.Path;
		string incoming = Document?.Text ?? string.Empty;
		if (!string.Equals(path, _loadedPath, StringComparison.Ordinal) ||
			(!_dirty && !string.Equals(incoming, _text, StringComparison.Ordinal)))
		{
			if (_dirty && !string.IsNullOrEmpty(_loadedPath))
				await FlushSaveAsync();

			_loadedPath = path;
			_text = incoming;
			_dirty = false;
			_encodingLabel = string.IsNullOrWhiteSpace(Document?.EncodingName)
				? "UTF-8"
				: Document.EncodingName;
			_language = ReaderSyntaxHighlighter.DetectLanguage(Document?.Title ?? path);
			_previewKind = ReaderPreviewRenderer.Detect(Document?.Title ?? path);
			_canSave = Document != null &&
				Document.Kind == DocumentKind.Text &&
				!string.IsNullOrEmpty(path) &&
				!Document.WasTruncated;
			ClearHistory();
			PushHistory(_text);
			RefreshHighlightImmediate();
			_showFind = false;
			_showReplace = false;
			_showGoToLine = false;
			_shouldRender = true;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		LoadEditorSettings();
		await EnsureFontCssAsync();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			try
			{
				_module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./reader-text-editor.js");
			}
			catch
			{
			}
		}

		// Blazor re-renders wipe DOM mutations on empty <textarea>/<pre>; always restore.
		await SetTextareaValueAsync(_text);
		await PushOverlayAsync();
		await PushStatsAsync();
		if (_restoreCaret)
		{
			await RestoreCaretAsync();
			_restoreCaret = false;
		}
		await RefreshActiveLineAsync();
		await EnsureListenersAsync();
	}

	public async Task FlushSaveAsync()
	{
		if (!_canSave)
			return;
		if (!_dirty && Document != null && string.Equals(Document.Text, _text, StringComparison.Ordinal))
			return;
		bool ok = await DocumentReaderService.SaveActiveTextAsync(_text);
		if (ok)
		{
			_dirty = false;
			if (Document != null)
				Document.Text = _text;
		}
		else
		{
			FeedbackService.ShowToast(LanguageService["reader_editor_save_failed"], FeedbackSeverity.Warning);
		}
	}

	public async Task ToggleWordWrapAsync()
	{
		_wordWrap = !_wordWrap;
		PersistEditorSettings();
		await SettingsChanged.InvokeAsync();
		await RequestRenderAsync();
	}

	public async Task ChooseFontAsync()
	{
		bool picked = await FilePickerService.PickFile(new[] { ".ttf", ".otf" }, "font/*");
		if (!picked)
		{
			if (!string.IsNullOrEmpty(GetSavedFontFileName()))
			{
				var answer = await FeedbackService.ShowMessageAsync(
					LanguageService["reader_editor_font_reset_q"],
					LanguageService["reader_editor_font"],
					MessageBoxButtons.YesNoCancel,
					false);
				if (answer == MessageBoxResult.Yes)
				{
					ClearCustomFont();
					await EnsureFontCssAsync();
					PersistEditorSettings();
					await SettingsChanged.InvokeAsync();
					await RequestRenderAsync();
				}
			}
			return;
		}

		try
		{
			byte[] bytes = await FilePickerService.ReadPickedFile();
			string name = FilePickerService.GetPickedFileName() ?? "custom.ttf";
			if (!await InstallCustomFontAsync(bytes, name))
			{
				FeedbackService.ShowToast(LanguageService["reader_editor_font_failed"], FeedbackSeverity.Warning);
				return;
			}
			await EnsureFontCssAsync();
			await SettingsChanged.InvokeAsync();
			await RequestRenderAsync();
		}
		catch (Exception)
		{
			FeedbackService.ShowToast(LanguageService["reader_editor_font_failed"], FeedbackSeverity.Warning);
		}
	}

	public void OpenPreview()
	{
		if (!CanPreview)
			return;
		_previewHtml = ReaderPreviewRenderer.Render(_previewKind, _text, Document?.Title ?? Document?.Path);
		_previewOpen = true;
		RequestRender();
	}

	private void ClosePreview()
	{
		_previewOpen = false;
		RequestRender();
	}

	private bool IsFlashing(string id) =>
		_flashUntil.TryGetValue(id, out DateTime until) && until > DateTime.UtcNow;

	private async Task FlashButtonAsync(string id)
	{
		_flashUntil[id] = DateTime.UtcNow.Add(FlashDuration);
		await RequestRenderAsync();
		_flashCts?.Cancel();
		_flashCts = new CancellationTokenSource();
		CancellationToken token = _flashCts.Token;
		_ = ClearFlashLaterAsync(id, token);
	}

	private async Task ClearFlashLaterAsync(string id, CancellationToken token)
	{
		try
		{
			await Task.Delay(FlashDuration, token);
			if (_flashUntil.TryGetValue(id, out DateTime until) && until <= DateTime.UtcNow.AddMilliseconds(50))
			{
				_flashUntil.Remove(id);
				await InvokeAsync(RequestRenderAsync);
			}
		}
		catch (TaskCanceledException)
		{
		}
	}

	private async Task RefreshActiveLineAsync()
	{
		if (_module == null)
			return;
		try
		{
			await _module.InvokeVoidAsync("updateActiveLine", _textareaRef, _activeLineRef);
		}
		catch
		{
		}
	}

	private async Task SyncScrollAsync()
	{
		if (_module == null)
			return;
		try
		{
			await _module.InvokeVoidAsync("syncScroll", _textareaRef, _highlightRef, _gutterRef, _activeLineRef);
		}
		catch
		{
		}
	}

	private async Task EnsureListenersAsync()
	{
		if (_listenersAttached || _module == null)
			return;
		try
		{
			await _module.InvokeVoidAsync(
				"attachEditorListeners",
				_textareaRef,
				_highlightRef,
				_gutterRef,
				_activeLineRef);
			_listenersAttached = true;
		}
		catch
		{
		}
	}

	private async Task CaptureCaretAsync()
	{
		if (_module == null)
			return;
		try
		{
			CaretInfo caret = await _module.InvokeAsync<CaretInfo>("getCaret", _textareaRef);
			_restoreCaretStart = caret?.Start ?? 0;
			_restoreCaretEnd = caret?.End ?? _restoreCaretStart;
			_restoreScrollTop = caret?.ScrollTop ?? 0;
			_restoreCaret = true;
		}
		catch
		{
		}
	}

	private async Task RestoreCaretAsync()
	{
		if (_module == null)
			return;
		try
		{
			await _module.InvokeVoidAsync(
				"setCaret",
				_textareaRef,
				_restoreCaretStart,
				_restoreCaretEnd,
				_restoreScrollTop);
		}
		catch
		{
		}
	}

	private async Task OnBlurAsync()
	{
		await FlushSaveAsync();
	}

	private void OnInput(ChangeEventArgs args)
	{
		// Do not RequestRender here: re-rendering the empty <textarea> resets caret/value.
		_text = args?.Value?.ToString() ?? string.Empty;
		_dirty = true;
		RefreshStats();
		_ = PushStatsAsync();
		ScheduleHighlight();
		ScheduleHistorySnapshot();
	}

	private void ScheduleHighlight()
	{
		_highlightCts?.Cancel();
		_highlightCts = new CancellationTokenSource();
		CancellationToken token = _highlightCts.Token;
		_ = DebouncedHighlightAsync(token);
	}

	private async Task DebouncedHighlightAsync(CancellationToken token)
	{
		try
		{
			await Task.Delay(120, token);
			RefreshHighlightImmediate();
			await PushOverlayAsync();
			await PushStatsAsync();
		}
		catch (TaskCanceledException)
		{
		}
	}

	private void ScheduleHistorySnapshot()
	{
		if (_applyingHistory)
			return;
		_historyCts?.Cancel();
		_historyCts = new CancellationTokenSource();
		CancellationToken token = _historyCts.Token;
		_ = DebouncedHistoryAsync(token);
	}

	private async Task DebouncedHistoryAsync(CancellationToken token)
	{
		try
		{
			await Task.Delay(450, token);
			PushHistory(_text);
		}
		catch (TaskCanceledException)
		{
		}
	}

	private void ClearHistory()
	{
		_history.Clear();
		_historyIndex = -1;
	}

	private void PushHistory(string text)
	{
		if (_applyingHistory)
			return;
		text ??= string.Empty;
		if (_historyIndex >= 0 && _historyIndex < _history.Count &&
			string.Equals(_history[_historyIndex], text, StringComparison.Ordinal))
		{
			return;
		}

		if (_historyIndex < _history.Count - 1)
			_history.RemoveRange(_historyIndex + 1, _history.Count - _historyIndex - 1);

		_history.Add(text);
		while (_history.Count > MaxHistory)
		{
			_history.RemoveAt(0);
		}
		_historyIndex = _history.Count - 1;
	}

	private void PushHistoryBeforeMutation()
	{
		PushHistory(_text);
	}

	private void RefreshHighlightImmediate()
	{
		_highlightHtml = ReaderSyntaxHighlighter.ToHighlightedHtml(_text, _language);
		int lines = CountLines(_text);
		var sb = new StringBuilder(Math.Max(1, lines) * 4);
		for (int i = 1; i <= Math.Max(1, lines); i++)
		{
			if (i > 1)
				sb.Append('\n');
			sb.Append(i);
		}
		_lineNumbers = sb.ToString();
		RefreshStats();
	}

	private void RefreshStats()
	{
		string text = _text ?? string.Empty;
		int chars = text.Length;
		int lines = CountLines(text);
		int blank = CountBlankLines(text);
		int words = CountWords(text);
		_statsText = string.Format(
			System.Globalization.CultureInfo.InvariantCulture,
			"CH {0}  LN {1}  BL {2}  WO {3}  ENC {4}",
			chars,
			lines,
			blank,
			words,
			string.IsNullOrWhiteSpace(_encodingLabel) ? "UTF-8" : _encodingLabel);
	}

	private static int CountLines(string text)
	{
		if (string.IsNullOrEmpty(text))
			return 0;
		int lines = 1;
		for (int i = 0; i < text.Length; i++)
		{
			if (text[i] == '\n')
				lines++;
		}
		return lines;
	}

	private static int CountBlankLines(string text)
	{
		if (string.IsNullOrEmpty(text))
			return 0;
		int blank = 0;
		int lineStart = 0;
		for (int i = 0; i <= text.Length; i++)
		{
			if (i == text.Length || text[i] == '\n')
			{
				bool isBlank = true;
				for (int j = lineStart; j < i; j++)
				{
					if (!char.IsWhiteSpace(text[j]))
					{
						isBlank = false;
						break;
					}
				}
				if (isBlank)
					blank++;
				lineStart = i + 1;
			}
		}
		return blank;
	}

	private static int CountWords(string text)
	{
		if (string.IsNullOrEmpty(text))
			return 0;
		int words = 0;
		bool inWord = false;
		foreach (char c in text)
		{
			if (char.IsWhiteSpace(c))
			{
				inWord = false;
			}
			else if (!inWord)
			{
				inWord = true;
				words++;
			}
		}
		return words;
	}

