@using MudBlazor
@using SilentNotes.Models
@using SilentNotes.Services
@using SilentNotes.ViewModels
@using SilentNotes.Workers

@inject ILanguageService LanguageService
@inject IAbroAiChatLauncher AiChatLauncher
@inject IFeedbackService FeedbackService

<style type="text/css">
	.file-root {
		background-color: #000000;
		min-height: calc(100vh - 208px);
		padding: 10px;
		color: #ffffff;
	}
	.file-toolbar {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 2px 4px 10px 4px;
		border-bottom: 1px solid #202020;
	}
	.file-path {
		font-family: ui-monospace, "Cascadia Code", monospace;
		font-size: 0.85rem;
		color: #cccccc;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		flex-grow: 1;
	}
	.file-btn {
		border: 1px solid #2b2b2b;
		border-radius: 10px;
		background-color: #000000;
		color: #ffffff;
		height: 40px;
		padding: 0 14px;
		font-size: 0.9rem;
		cursor: pointer;
		touch-action: manipulation;
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.file-btn.primary {
		border-color: var(--mud-palette-primary);
		color: var(--mud-palette-primary);
	}
	.file-btn:active {
		background-color: #1f1f1f;
	}
	.file-selection-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		padding: 8px 4px;
		border-bottom: 1px solid #202020;
		align-items: center;
	}
	.file-row {
		display: flex;
		align-items: center;
		padding: 10px 6px;
		border-bottom: 1px solid #202020;
		gap: 8px;
	}
	.file-row.selected {
		background: rgba(36, 129, 204, 0.18);
	}
	.file-row-main {
		flex-grow: 1;
		overflow: hidden;
		cursor: pointer;
	}
	.file-row-name {
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.file-row-meta {
		font-size: 0.8rem;
		color: #9e9e9e;
	}
	.file-overlay {
		position: fixed;
		z-index: 1400;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		overflow-y: auto;
		background-color: #000000;
		padding: 14px;
		color: #ffffff;
	}
	.file-overlay-header {
		display: flex;
		align-items: center;
		margin-bottom: 12px;
	}
	.file-overlay-title {
		font-size: 1.15rem;
		font-weight: 600;
		margin-left: 4px;
	}
	.file-locations-bar {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding: 0 4px 8px 4px;
		border-bottom: 1px solid #202020;
	}
</style>

<div class="file-root">
	<div class="file-toolbar" style="flex-wrap:wrap;">
		@for (int i = 0; i < ViewModel.PathTabs.Count; i++)
		{
			int tabIndex = i;
			<button class="file-btn @(tabIndex == ViewModel.ActivePathTabIndex ? "primary" : null)"
				@onclick="() => SelectPathTabAsync(tabIndex)"
				title="@(ViewModel.PathTabs[tabIndex].Path)">
				<span>@(string.IsNullOrEmpty(ViewModel.PathTabs[tabIndex].Label) ? "/" : ViewModel.PathTabs[tabIndex].Label)</span>
				@if (ViewModel.PathTabs.Count > 1)
				{
					<span @onclick:stopPropagation="true" @onclick="() => ClosePathTabAsync(tabIndex)">✕</span>
				}
			</button>
		}
		<button class="file-btn" @onclick="AddPathTabAsync" title="@LanguageService["path_tab_add"]">+</button>
	</div>

	<div class="file-toolbar">
		@if (ViewModel.CanNavigateUp)
		{
			<MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Inherit"
				Disabled="@ViewModel.IsBusy" OnClick="NavigateUpAsync" title="@LanguageService["file_up"]" />
		}
		<div class="file-path" title="@ViewModel.CurrentPathDisplay">@ViewModel.CurrentPathDisplay</div>

		<MudIconButton Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" Color="Color.Primary"
			Disabled="@ViewModel.IsBusy" OnClick="UploadFileAsync" title="@LanguageService["file_upload"]" />
		<MudIconButton Icon="@Icons.Material.Filled.NoteAdd" Size="Size.Small" Color="Color.Inherit"
			Disabled="@(!ViewModel.IsConfigured || ViewModel.IsBusy)" OnClick="() => ViewModel.OpenNewTextFileCommand.Execute(null)" title="@LanguageService["file_new_txt"]" />
		<MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" Color="Color.Inherit"
			Disabled="@(!ViewModel.IsConfigured || ViewModel.IsBusy)" OnClick="() => ViewModel.OpenNewFolderCommand.Execute(null)" title="@LanguageService["file_new_folder"]" />
		<MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Inherit"
			Disabled="@(!ViewModel.IsConfigured || ViewModel.IsBusy)" OnClick="RefreshAsync" title="@LanguageService["file_refresh"]" />
		<MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Inherit"
			OnClick="() => ViewModel.OpenSettingsCommand.Execute(null)" title="@LanguageService["file_settings"]" />
	</div>

	<div class="file-locations-bar">
		<MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Color="Color.Inherit"
			AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
			title="@LanguageService["file_cloud_locations_menu"]">
			<MudMenuItem OnClick="() => OpenCloudLocationTabAsync(null)">
				@LanguageService["file_cloud_location_primary"]
			</MudMenuItem>
			@foreach (var location in ViewModel.ExtraCloudLocations)
			{
				if (location == null)
				{
					continue;
				}
				<MudMenuItem OnClick="() => OpenCloudLocationTabAsync(location.Id)">
					@location.DisplayName
				</MudMenuItem>
			}
		</MudMenu>
	</div>

	@if (ViewModel.HasSelection)
	{
		<div class="file-selection-bar">
			<span>@ViewModel.SelectedCount</span>
			<button class="file-btn" disabled="@ViewModel.IsBusy" @onclick="ZipSelectedAsync">@LanguageService["file_zip"]</button>
			<button class="file-btn" disabled="@ViewModel.IsBusy" @onclick="UnzipSelectedAsync">@LanguageService["file_unzip"]</button>
			<button class="file-btn" disabled="@ViewModel.IsBusy" @onclick="SplitSelectedAsync">@LanguageService["file_split"]</button>
			<button class="file-btn" @onclick="ClearSelection">@LanguageService["file_clear_selection"]</button>
		</div>
	}

	@if (ViewModel.IsNewFolderOpen)
	{
		<div class="d-flex align-center gap-2 my-2">
			<MudTextField T="string" @bind-Value="ViewModel.NewFolderName" Placeholder="@LanguageService["file_folder_name"]"
				Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Immediate="true" />
			<MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" OnClick="CreateFolderAsync" />
			<MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => ViewModel.CloseOverlayCommand.Execute(null)" />
		</div>
	}

	@if (ViewModel.IsNewTextFileOpen)
	{
		<div class="d-flex align-center gap-2 my-2">
			<MudTextField T="string" @bind-Value="ViewModel.NewTextFileName" Placeholder="@LanguageService["file_txt_name"]"
				Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Immediate="true" />
			<MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" OnClick="CreateTextFileAsync" />
			<MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => ViewModel.CloseOverlayCommand.Execute(null)" />
		</div>
	}

	@if (!ViewModel.IsConfigured)
	{
		<div class="pa-6 text-center">
			<MudText Class="mb-3 mud-text-secondary">@LanguageService["file_not_configured"]</MudText>
			<button class="file-btn primary" @onclick="() => ViewModel.OpenSettingsCommand.Execute(null)">
				<MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
				<span>@LanguageService["file_configure_webdav"]</span>
			</button>
		</div>
	}
	else if (ViewModel.IsBusy)
	{
		<div class="d-flex justify-center align-center pa-8">
			<MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
			<MudText Class="ml-3">@LanguageService["file_working"]</MudText>
		</div>
	}
	else if (!string.IsNullOrEmpty(ViewModel.LastError))
	{
		<MudAlert Severity="Severity.Warning" Dense="true" Class="my-3">
			<div>@ViewModel.LastError</div>
			<div class="mt-2">
				<MudButton Size="Size.Small" Color="Color.Primary" OnClick="RefreshAsync">@LanguageService["file_retry"]</MudButton>
				<MudButton Size="Size.Small" Color="Color.Inherit" Class="ml-2" OnClick="() => ViewModel.OpenSettingsCommand.Execute(null)">@LanguageService["file_settings"]</MudButton>
			</div>
		</MudAlert>
	}
	else if (ViewModel.IsEmpty)
	{
		<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["file_empty"]</MudText>
	}
	else if (ViewModel.HasNoMatches)
	{
		<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["file_no_matches"]</MudText>
	}
	else
	{
		@foreach (var item in ViewModel.FilteredItems)
		{
			<div class="file-row @(ViewModel.IsSelected(item) ? "selected" : null)" @key="item.Name">
				@if (!item.IsDirectory)
				{
					<MudCheckBox T="bool" Dense="true" Value="@ViewModel.IsSelected(item)"
						ValueChanged="@((bool _) => ToggleSelection(item))" />
				}
				else
				{
					<span style="width:42px"></span>
				}
				<MudIcon Icon="@(item.IsDirectory ? Icons.Material.Filled.Folder : Icons.Material.Filled.InsertDriveFile)"
					Color="@(item.IsDirectory ? Color.Warning : Color.Secondary)" />

				<div class="file-row-main" @onclick="() => OpenItemAsync(item)">
					<div class="file-row-name">@item.Name</div>
					<div class="file-row-meta">@item.MetaText</div>
				</div>

				@if (!item.IsDirectory)
				{
					<span @onclick:stopPropagation="true">
						<MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small"
							OnClick="() => AskAiAboutFileAsync(item)" title="@LanguageService["ask_ai"]" />
					</span>
					@if (IsImageFile(item.Name))
					{
						<MudIconButton Icon="@Icons.Material.Filled.Crop" Size="Size.Small"
							OnClick="() => CropImageAsync(item)" title="@LanguageService["file_crop"]" />
					}
					<MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
						OnClick="() => DownloadFileAsync(item)" title="@LanguageService["file_download"]" />
					<MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small"
						OnClick="() => ShareFileAsync(item)" title="@LanguageService["share"]" />
				}
				<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
					OnClick="() => DeleteItemAsync(item)" title="@LanguageService["file_delete"]" />
			</div>
		}
	}
</div>

@if (ViewModel.IsSettingsOpen)
{
	<div class="file-overlay">
		<div class="file-overlay-header">
			<MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit"
				OnClick="() => ViewModel.CloseOverlayCommand.Execute(null)" title="@LanguageService["back"]" />
			<div class="file-overlay-title">@LanguageService["file_settings"]</div>
		</div>

		<MudStack Spacing="3">
			<MudTextField T="string" @bind-Value="ViewModel.EditUrl" Label="@LanguageService["file_webdav_url"]"
				Placeholder="https://example.com/remote.php/dav/files/user" Variant="Variant.Outlined" />
			<MudTextField T="string" @bind-Value="ViewModel.EditFolder" Label="@LanguageService["file_webdav_folder"]"
				Placeholder="files" Variant="Variant.Outlined" />
			<MudTextField T="string" @bind-Value="ViewModel.EditUsername" Label="@LanguageService["cloud_username"]"
				Variant="Variant.Outlined" />
			<MudTextField T="string" @bind-Value="ViewModel.EditPassword" Label="@LanguageService["cloud_password"]"
				InputType="InputType.Password" Variant="Variant.Outlined" />

			<MudText Typo="Typo.subtitle2" Class="mt-4">@LanguageService["file_cloud_locations_title"]</MudText>
			<MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@LanguageService["file_cloud_locations_hint"]</MudText>
			@foreach (var location in ViewModel.EditCloudLocations)
			{
				<MudPaper Class="pa-3 mb-2" Outlined="true">
					<MudTextField T="string" @bind-Value="location.DisplayName" Label="@LanguageService["file_cloud_location_name"]"
						Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
					<MudSelect T="string" @bind-Value="location.ProviderId" Label="@LanguageService["file_cloud_provider"]"
						Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
						<MudSelectItem T="string" Value="@CloudFileLocationModel.ProviderWebdav">WebDAV</MudSelectItem>
						<MudSelectItem T="string" Value="@CloudFileLocationModel.ProviderDropbox">Dropbox</MudSelectItem>
						<MudSelectItem T="string" Value="@CloudFileLocationModel.ProviderGoogleDrive">Google Drive</MudSelectItem>
						<MudSelectItem T="string" Value="@CloudFileLocationModel.ProviderOneDrive">OneDrive</MudSelectItem>
						<MudSelectItem T="string" Value="@CloudFileLocationModel.ProviderMega">MEGA (coming soon)</MudSelectItem>
					</MudSelect>
					@if (string.Equals(location.ProviderId, CloudFileLocationModel.ProviderWebdav, StringComparison.OrdinalIgnoreCase))
					{
						<MudTextField T="string" @bind-Value="location.Url" Label="@LanguageService["file_webdav_url"]"
							Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
						<MudTextField T="string" @bind-Value="location.RemoteFolder" Label="@LanguageService["file_webdav_folder"]"
							Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
						<MudTextField T="string" @bind-Value="location.Username" Label="@LanguageService["cloud_username"]"
							Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
						<MudTextField T="string" @bind-Value="location.Password" Label="@LanguageService["cloud_password"]"
							InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
					}
					else if (!string.Equals(location.ProviderId, CloudFileLocationModel.ProviderMega, StringComparison.OrdinalIgnoreCase))
					{
						<MudTextField T="string" @bind-Value="location.RemoteFolder" Label="@LanguageService["file_cloud_remote_folder"]"
							Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
						<MudSwitch @bind-Value="location.UseRepositoryCredentials" Color="Color.Tertiary"
							Label="@LanguageService["file_cloud_use_repo_credentials"]" />
					}
					else
					{
						<MudAlert Severity="Severity.Info" Dense="true">@LanguageService["file_cloud_mega_coming_soon"]</MudAlert>
					}
					<MudButton Size="Size.Small" Color="Color.Error" Class="mt-2"
						OnClick="() => ViewModel.RemoveExtraCloudLocation(location)">@LanguageService["delete"]</MudButton>
				</MudPaper>
			}
			<MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
				OnClick="() => ViewModel.AddExtraCloudLocation()">@LanguageService["file_cloud_add_location"]</MudButton>

			<div class="d-flex justify-end gap-2 mt-2">
				<button class="file-btn" @onclick="() => ViewModel.CloseOverlayCommand.Execute(null)">@LanguageService["cancel"]</button>
				<button class="file-btn primary" @onclick="SaveSettingsAsync">@LanguageService["file_save_connect"]</button>
			</div>
		</MudStack>
	</div>
}

@code {
	[Parameter]
	public FileViewModel ViewModel { get; set; }

	protected override async Task OnInitializedAsync()
	{
		if (ViewModel != null)
			await ViewModel.InitializeAsync();
	}

	private async Task RefreshAsync()
	{
		await ViewModel.RefreshAsync();
		StateHasChanged();
	}

	private async Task UploadFileAsync()
	{
		await ViewModel.UploadFileAsync();
		StateHasChanged();
	}

	private async Task NavigateUpAsync()
	{
		await ViewModel.NavigateUpAsync();
		StateHasChanged();
	}

	private async Task OpenItemAsync(WebdavFileItemViewModel item)
	{
		await ViewModel.OpenItemAsync(item);
		StateHasChanged();
	}

	private async Task DownloadFileAsync(WebdavFileItemViewModel item)
	{
		await ViewModel.DownloadFileToDeviceAsync(item);
		StateHasChanged();
	}

	private void ToggleSelection(WebdavFileItemViewModel item)
	{
		ViewModel.ToggleSelection(item);
		StateHasChanged();
	}

	private void ClearSelection()
	{
		ViewModel.ClearSelection();
		StateHasChanged();
	}

	private async Task ZipSelectedAsync()
	{
		await ViewModel.ZipSelectedAsync();
		StateHasChanged();
	}

	private async Task UnzipSelectedAsync()
	{
		await ViewModel.UnzipSelectedAsync();
		StateHasChanged();
	}

	private async Task SplitSelectedAsync()
	{
		await ViewModel.SplitSelectedAsync(5);
		StateHasChanged();
	}

	private async Task CropImageAsync(WebdavFileItemViewModel item)
	{
		await ViewModel.CropImageAsync(item);
		StateHasChanged();
	}

	private static bool IsImageFile(string name)
	{
		string ext = System.IO.Path.GetExtension(name ?? string.Empty).ToLowerInvariant();
		return ext is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".bmp" or ".heic" or ".avif";
	}

	private async Task AskAiAboutFileAsync(WebdavFileItemViewModel item)
	{
		if (item == null || item.IsDirectory)
			return;

		if (!AiChatLauncher.IsSupported)
		{
			FeedbackService.ShowToast(LanguageService["ask_ai_unavailable"]);
			return;
		}

		FeedbackService.ShowToast(LanguageService["ask_ai_file_loading"]);
		try
		{
			string fileText = await ViewModel.ReadFileTextForAiAsync(item);
			string pathHint = $"{ViewModel.CurrentPathDisplay}/{item.Name}\n{item.MetaText}";
			string context = string.IsNullOrWhiteSpace(fileText)
				? pathHint
				: pathHint + "\n\n" + fileText;
			await AiChatLauncher.AskAiAboutAsync(item.Name, context);
		}
		catch (Exception ex)
		{
			FeedbackService.ShowToast(
				LanguageService["ask_ai_file_failed"] + " — " + ex.Message,
				FeedbackSeverity.Warning);
		}
	}

	private async Task ShareFileAsync(WebdavFileItemViewModel item)
	{
		await ViewModel.ShareFileAsync(item);
		StateHasChanged();
	}

	private async Task DeleteItemAsync(WebdavFileItemViewModel item)
	{
		await ViewModel.DeleteItemAsync(item);
		StateHasChanged();
	}

	private async Task CreateFolderAsync()
	{
		await ViewModel.CreateFolderAsync();
		StateHasChanged();
	}

	private async Task CreateTextFileAsync()
	{
		await ViewModel.CreateTextFileAsync();
		StateHasChanged();
	}

	private async Task AddPathTabAsync()
	{
		await ViewModel.AddPathTabAsync();
		StateHasChanged();
	}

	private async Task ClosePathTabAsync(int index)
	{
		await ViewModel.ClosePathTabAsync(index);
		StateHasChanged();
	}

	private async Task SelectPathTabAsync(int index)
	{
		await ViewModel.SelectPathTabAsync(index);
		StateHasChanged();
	}

	private async Task SaveSettingsAsync()
	{
		await ViewModel.SaveSettingsAsync();
		StateHasChanged();
	}

	private async Task OpenCloudLocationTabAsync(string locationId)
	{
		await ViewModel.OpenCloudLocationAsNewTabAsync(locationId ?? string.Empty);
		StateHasChanged();
	}
}
