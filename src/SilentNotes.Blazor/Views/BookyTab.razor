@using MudBlazor
@using SilentNotes.Models
@using SilentNotes.Services
@using SilentNotes.ViewModels

@inject ILanguageService LanguageService

<style type="text/css">
	.booky-list {
		overflow-y: auto;
		max-height: calc(100vh - 300px);
	}
	.booky-title {
		font-weight: 600;
		word-break: break-word;
	}
	.booky-quote {
		white-space: pre-wrap;
		word-break: break-word;
	}
	.booky-host {
		word-break: break-all;
	}
	.booky-host-broken {
		color: var(--mud-palette-error) !important;
	}
	.booky-link-warning {
		margin-right: 4px;
	}
	.booky-draft-overlay {
		z-index: 1300;
	}
	.booky-offline-overlay {
		position: fixed;
		inset: 0;
		z-index: 1400;
		background: var(--mud-palette-background);
		display: flex;
		flex-direction: column;
		padding: 8px;
	}
	.booky-offline-sheet {
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
		overflow: hidden;
	}
	.booky-offline-body {
		overflow-y: auto;
		flex: 1 1 auto;
		padding-bottom: 24px;
	}
	.theme-dark .booky-card {
		background-color: #000000;
	}
</style>

<div class="pa-2">
	@if (!ViewModel.IsEmpty)
	{
		<MudStack Row="true" Spacing="1" Class="mb-2 flex-wrap">
			<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary"
			         Disabled="@ViewModel.IsLinkCheckBusy"
			         OnClick="@RunLinkCheck">
				@(ViewModel.IsLinkCheckBusy ? LanguageService["booky_link_check_busy"] : LanguageService["booky_link_check"])
			</MudChip>
			<MudChip T="string" Variant="Variant.Outlined"
			         Color="@(ViewModel.FilterBrokenOnly ? Color.Error : Color.Default)"
			         OnClick="@ToggleBrokenFilter">
				@LanguageService["booky_filter_broken"]
			</MudChip>
		</MudStack>
	}
	@if (ViewModel.IsEmpty)
	{
		<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["booky_empty"]</MudText>
	}
	else if (ViewModel.FilterBrokenOnly && ViewModel.FilteredBookmarks.Count == 0)
	{
		<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["booky_no_broken"]</MudText>
	}
	else
	{
		<div class="booky-list">
			@if (ViewModel.IsGrouped)
			{
				<MudExpansionPanels Elevation="0" Dense="true">
					@foreach (var group in ViewModel.Groups)
					{
						<MudExpansionPanel Text="@($"{group.Host} ({group.Count})")">
							@foreach (var bookmark in group.Items)
							{
								@RenderBookmark(bookmark)
							}
						</MudExpansionPanel>
					}
				</MudExpansionPanels>
			}
			else
			{
				@foreach (var bookmark in ViewModel.FilteredBookmarks)
				{
					@RenderBookmark(bookmark)
				}
			}
		</div>
	}
</div>

@if (ViewModel.IsDraftVisible)
{
	<MudOverlay Visible="true" Class="booky-draft-overlay" DarkBackground="true" />
	<div class="pa-4" style="position:fixed; z-index:1400; top:15%; left:0; right:0;">
		<MudPaper Elevation="4" Class="pa-4 mx-auto" MaxWidth="480px">
			<MudText Typo="Typo.h6" Class="mb-3">@LanguageService["booky_add"]</MudText>
			<MudTextField @bind-Value="ViewModel.DraftUrl" Label="@LanguageService["booky_url"]" Variant="Variant.Outlined" Class="mb-3" />
			<MudTextField @bind-Value="ViewModel.DraftTitle" Label="@LanguageService["booky_title"]" Variant="Variant.Outlined" Class="mb-3" />
			<MudTextField @bind-Value="ViewModel.DraftQuote" Label="@LanguageService["booky_quote"]" Variant="Variant.Outlined" Lines="3" Class="mb-3" />
			@if (!string.IsNullOrEmpty(ViewModel.DraftError))
			{
				<MudText Color="Color.Error" Class="mb-3">@ViewModel.DraftError</MudText>
			}
			<MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
				<MudButton Variant="Variant.Text" OnClick="@(() => ViewModel.CancelDraftCommand.Execute(null))">@LanguageService["cancel"]</MudButton>
				<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ViewModel.SaveDraftCommand.Execute(null))">@LanguageService["booky_save"]</MudButton>
			</MudStack>
		</MudPaper>
	</div>
}

@if (ViewModel.IsOfflineVisible)
{
	<div class="booky-offline-overlay">
		<div class="booky-offline-sheet">
			<div class="d-flex align-center mb-2">
				<MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => ViewModel.CloseOfflineCommand.Execute(null))" />
				<MudText Typo="Typo.subtitle1" Class="flex-grow-1">@ViewModel.OfflineTitle</MudText>
			</div>
			<div class="booky-offline-body">
				@if (!string.IsNullOrWhiteSpace(ViewModel.OfflineHtml))
				{
					<div class="rss-article-content">@((MarkupString)ViewModel.OfflineHtml)</div>
				}
				else
				{
					<MudText>@ViewModel.OfflinePlain</MudText>
				}
			</div>
		</div>
	</div>
}

@code {
	/// <summary>
	/// Gets or sets the view model of the booky tab.
	/// </summary>
	[Parameter]
	public BookyViewModel ViewModel { get; set; }

	private void ToggleBrokenFilter()
	{
		ViewModel.FilterBrokenOnly = !ViewModel.FilterBrokenOnly;
	}

	private void RunLinkCheck()
	{
		bool hasListFilter = !string.IsNullOrWhiteSpace(ViewModel.Filter) || ViewModel.FilterBrokenOnly;
		if (hasListFilter)
			ViewModel.CheckSelectedLinksCommand.Execute(null);
		else
			ViewModel.CheckLinksCommand.Execute(null);
	}

	private RenderFragment RenderBookmark(BookmarkItemViewModel bookmark)
	{
		return @<MudPaper Elevation="1" Class="pa-2 my-2 booky-card d-flex align-start">
			<div class="flex-grow-1 overflow-hidden" style="cursor:pointer" @onclick="() => ViewModel.OpenCommand.Execute(bookmark)">
				<MudText Class="booky-title">
					@if (bookmark.IsBroken)
					{
						<span class="booky-link-warning" title="@bookmark.LinkStatusText">@bookmark.LinkWarningGlyph</span>
					}
					@bookmark.Title @bookmark.OfflineBadge
				</MudText>
				@if (!string.IsNullOrWhiteSpace(bookmark.Quote))
				{
					<MudText Class="booky-quote mud-text-secondary mt-1">@bookmark.Quote</MudText>
				}
				<MudText Typo="Typo.caption" Class="@($"booky-host mud-text-secondary mt-1{(bookmark.IsBroken ? " booky-host-broken" : "")}")">@bookmark.Url</MudText>
				@if (!string.IsNullOrWhiteSpace(bookmark.LinkStatusText))
				{
					<MudText Typo="Typo.caption" Class="mud-text-secondary">@bookmark.LinkStatusText</MudText>
				}
			</div>
			<MudStack Row="true" Spacing="0" Class="flex-shrink-0">
				@if (bookmark.IsOffline)
				{
					<MudIconButton Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" OnClick="@(() => ViewModel.ReadOfflineCommand.Execute(bookmark))" title="@LanguageService["booky_read_offline"]" />
				}
				<MudIconButton Icon="@(bookmark.IsOffline ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" Size="Size.Small"
					Color="@(bookmark.IsOffline ? Color.Warning : Color.Inherit)"
					OnClick="@(() => ViewModel.SaveOfflineCommand.Execute(bookmark))" title="@LanguageService["rss_offline"]" />
				<AskAiButton Subject="@bookmark.Title" ContextText="@($"{bookmark.Title}\n{bookmark.Url}\n{bookmark.Quote}")" />
				<MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" OnClick="@(() => ViewModel.OpenCommand.Execute(bookmark))" title="@LanguageService["booky_open"]" />
				<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => ViewModel.DeleteCommand.Execute(bookmark))" title="@LanguageService["booky_delete"]" />
			</MudStack>
		</MudPaper>;
	}
}
