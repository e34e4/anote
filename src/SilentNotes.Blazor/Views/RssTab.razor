@using CommunityToolkit.Mvvm.Input
@using MudBlazor
@using SilentNotes.Models
@using SilentNotes.Services
@using SilentNotes.ViewModels
@implements IDisposable

@inject ILanguageService LanguageService

<style type="text/css">
	.rss-root {
		background-color: #000000;
		min-height: calc(100vh - 208px);
		padding: 8px;
		color: #ffffff;
	}
	.rss-list {
		overflow-y: auto;
		max-height: calc(100vh - 280px);
	}
	.rss-row {
		padding: 10px 8px;
		border-bottom: 1px solid #1c1c1c;
		cursor: pointer;
	}
	.rss-row:active {
		background-color: #121212;
	}
	.rss-title-unread {
		font-weight: 700;
		color: #ffffff;
		word-break: break-word;
	}
	.rss-title-read {
		font-weight: 400;
		color: #c8c8c8;
		word-break: break-word;
	}
	.rss-meta {
		color: #8e8e8e;
		font-size: 0.78rem;
		margin-top: 2px;
	}
	.rss-summary {
		color: #a8a8a8;
		font-size: 0.85rem;
		margin-top: 4px;
		word-break: break-word;
	}
	.rss-actions {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
		margin: 8px 0;
	}
	.rss-btn {
		border: 1px solid #2b2b2b;
		border-radius: 10px;
		background-color: #0c0c0c;
		color: #ffffff;
		height: 36px;
		padding: 0 12px;
		font-size: 0.84rem;
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		gap: 5px;
		cursor: pointer;
	}
	.rss-btn.primary {
		border-color: var(--mud-palette-primary);
		color: var(--mud-palette-primary);
	}
	.rss-overlay {
		position: fixed;
		inset: 0;
		z-index: 1400;
		background: #000000;
		display: flex;
		flex-direction: column;
		padding: 8px;
		overflow: hidden;
	}
	.rss-overlay-header {
		display: flex;
		align-items: center;
		gap: 4px;
		min-height: 44px;
		border-bottom: 1px solid #1f1f1f;
		margin-bottom: 8px;
	}
	.rss-overlay-body {
		overflow-y: auto;
		flex: 1 1 auto;
		padding-bottom: 24px;
	}
	.rss-article-content {
		line-height: 1.45;
		word-break: break-word;
	}
	.rss-article-content img {
		max-width: 100%;
		height: auto;
	}
	.rss-article-content a {
		color: var(--mud-palette-primary);
	}
	.rss-feed-card {
		border: 1px solid #222;
		border-radius: 10px;
		padding: 10px;
		margin-bottom: 8px;
		background: #0a0a0a;
	}
	.rss-feed-url {
		color: #8e8e8e;
		font-size: 0.78rem;
		word-break: break-all;
	}
	.rss-draft-field {
		margin-bottom: 10px;
	}
</style>

<div class="rss-root">
	@if (ViewModel.IsFeedsPageOpen)
	{
		<div class="rss-overlay">
			<div class="rss-overlay-header">
				<MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit"
					OnClick="@(() => ViewModel.CloseFeedsPageCommand.Execute(null))" title="@LanguageService["back"]" />
				<MudText Typo="Typo.subtitle1" Class="flex-grow-1">@LanguageService["rss_feeds"]</MudText>
				<MudIconButton Icon="@Icons.Material.Filled.FileUpload" Color="Color.Inherit"
					OnClick="@ImportOpmlAsync" title="@LanguageService["rss_import_opml"]" />
				<MudIconButton Icon="@Icons.Material.Filled.FileDownload" Color="Color.Inherit"
					OnClick="@ExportOpmlAsync" title="@LanguageService["rss_export_opml"]" />
				<MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary"
					OnClick="@(() => ViewModel.StartAddFeedCommand.Execute(null))" title="@LanguageService["rss_add"]" />
			</div>
			<div class="rss-overlay-body">
				@if (!ViewModel.HasFeeds)
				{
					<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["rss_feeds_empty"]</MudText>
				}
				else
				{
					@foreach (var feed in ViewModel.Feeds)
					{
						<div class="rss-feed-card" @key="feed.Id">
							<div class="d-flex align-center">
								<div class="flex-grow-1">
									<MudText Typo="Typo.subtitle2">@feed.Title</MudText>
									<div class="rss-feed-url">@feed.Url</div>
								</div>
								<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
									OnClick="@(() => ViewModel.StartEditFeedCommand.Execute(feed))" title="@LanguageService["rss_edit"]" />
								<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
									OnClick="@(() => ViewModel.DeleteFeedCommand.Execute(feed))" title="@LanguageService["rss_delete"]" />
							</div>
						</div>
					}
				}
			</div>
		</div>
	}
	else if (ViewModel.IsArticleOpen && ViewModel.OpenedArticle != null)
	{
		var article = ViewModel.OpenedArticle;
		<div class="rss-overlay">
			<div class="rss-overlay-header">
				<MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit"
					OnClick="@(() => ViewModel.CloseArticleCommand.Execute(null))" title="@LanguageService["back"]" />
				<MudText Typo="Typo.subtitle2" Class="flex-grow-1">@article.FeedTitle</MudText>
				@if (!string.IsNullOrWhiteSpace(article.Link))
				{
					<MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Inherit"
						OnClick="@(() => ViewModel.OpenArticleLinkCommand.Execute(null))" title="@LanguageService["rss_open_link"]" />
				}
				<MudIconButton Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Inherit"
					OnClick="@SaveOpenedToWebdavAsync" title="@LanguageService["webdav_quick_save"]" />
			</div>
			<div class="rss-overlay-body">
				<MudText Typo="Typo.h6" Class="mb-1">@article.Title</MudText>
				<div class="rss-meta mb-3">
					@if (!string.IsNullOrEmpty(article.PublishedText))
					{
						<span>@article.PublishedText</span>
					}
				</div>
				@if (!string.IsNullOrWhiteSpace(article.ContentHtml))
				{
					<div class="rss-article-content">@((MarkupString)article.ContentHtml)</div>
				}
				else
				{
					<MudText Class="rss-article-content">@article.ContentPlain</MudText>
				}
			</div>
		</div>
	}
	else
	{
		<div class="rss-actions">
			<button type="button" class="rss-btn primary" disabled="@ViewModel.IsBusy" @onclick="RefreshAsync">
				@LanguageService["rss_refresh"]
			</button>
			<button type="button" class="rss-btn" @onclick="@(() => ViewModel.OpenFeedsPageCommand.Execute(null))">
				@LanguageService["rss_feeds"]
			</button>
			<button type="button" class="rss-btn" @onclick="@(() => ViewModel.StartAddFeedCommand.Execute(null))">
				@LanguageService["rss_add"]
			</button>
		</div>

		@if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
		{
			<MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@ViewModel.StatusMessage</MudText>
		}

		@if (ViewModel.IsBusy)
		{
			<div class="d-flex justify-center ma-6">
				<MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
			</div>
		}
		else if (ViewModel.IsEmpty)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["rss_empty"]</MudText>
		}
		else if (ViewModel.HasNoArticles)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["rss_no_articles"]</MudText>
		}
		else
		{
			<div class="rss-list">
				@foreach (var article in ViewModel.VisibleArticles)
				{
					<div class="rss-row" @key="article.ItemKey" @onclick="@(() => ViewModel.OpenArticleCommand.Execute(article))">
						<div class="@article.TitleCssClass">@article.Title</div>
						<div class="rss-meta">
							<span>@article.FeedTitle</span>
							@if (!string.IsNullOrEmpty(article.PublishedText))
							{
								<span> · @article.PublishedText</span>
							}
						</div>
						@if (!string.IsNullOrEmpty(article.Summary))
						{
							<div class="rss-summary">@article.Summary</div>
						}
					</div>
				}

				@if (ViewModel.CanLoadMore)
				{
					<div class="d-flex justify-center ma-4">
						<button type="button" class="rss-btn primary" @onclick="@(() => ViewModel.LoadMoreCommand.Execute(null))">
							@LanguageService["rss_load_more"]
						</button>
					</div>
				}
			</div>
		}
	}
</div>

@if (ViewModel.IsAddFeedOpen)
{
	<div class="rss-overlay" style="background: rgba(0,0,0,0.92);">
		<div class="rss-overlay" style="position: relative; inset: auto; max-width: 560px; margin: 48px auto 0; border: 1px solid #2a2a2a; border-radius: 12px; max-height: calc(100vh - 96px);">
			<div class="rss-overlay-header">
				<MudText Typo="Typo.subtitle1" Class="flex-grow-1 ml-2">
					@(ViewModel.IsEditingFeed ? LanguageService["rss_edit"] : LanguageService["rss_add"])
				</MudText>
				<MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit"
					OnClick="@(() => ViewModel.CancelFeedEditCommand.Execute(null))" title="@LanguageService["cancel"]" />
			</div>
			<div class="rss-overlay-body pa-2">
				<div class="rss-draft-field">
					<MudTextField @bind-Value="ViewModel.DraftFeedUrl"
						Label="@LanguageService["rss_feed_url"]"
						Variant="Variant.Outlined" Immediate="true" />
				</div>
				<div class="rss-draft-field">
					<MudTextField @bind-Value="ViewModel.DraftFeedTitle"
						Label="@LanguageService["rss_feed_title"]"
						Variant="Variant.Outlined" Immediate="true"
						HelperText="@LanguageService["rss_feed_title_hint"]" />
				</div>
				<div class="rss-actions">
					<button type="button" class="rss-btn primary" disabled="@ViewModel.IsBusy" @onclick="SaveFeedAsync">
						@LanguageService["rss_save"]
					</button>
					<button type="button" class="rss-btn" @onclick="@(() => ViewModel.CancelFeedEditCommand.Execute(null))">
						@LanguageService["cancel"]
					</button>
				</div>
			</div>
		</div>
	</div>
}

@code {
	[Parameter]
	public RssViewModel ViewModel { get; set; }

	protected override void OnInitialized()
	{
		if (ViewModel != null)
			ViewModel.StateChanged += OnViewModelStateChanged;
	}

	private void OnViewModelStateChanged()
	{
		InvokeAsync(StateHasChanged);
	}

	private async Task RefreshAsync()
	{
		await ViewModel.RefreshAsync();
		StateHasChanged();
	}

	private async Task SaveFeedAsync()
	{
		if (ViewModel.SaveFeedCommand is IAsyncRelayCommand asyncCommand)
			await asyncCommand.ExecuteAsync(null);
		else
			ViewModel.SaveFeedCommand.Execute(null);
		StateHasChanged();
	}

	private async Task ExportOpmlAsync()
	{
		if (ViewModel.ExportOpmlCommand is IAsyncRelayCommand asyncCommand)
			await asyncCommand.ExecuteAsync(null);
		else
			ViewModel.ExportOpmlCommand.Execute(null);
		StateHasChanged();
	}

	private async Task ImportOpmlAsync()
	{
		if (ViewModel.ImportOpmlCommand is IAsyncRelayCommand asyncCommand)
			await asyncCommand.ExecuteAsync(null);
		else
			ViewModel.ImportOpmlCommand.Execute(null);
		StateHasChanged();
	}

	private async Task SaveOpenedToWebdavAsync()
	{
		if (ViewModel.SaveArticleToWebdavCommand is IAsyncRelayCommand asyncCommand)
			await asyncCommand.ExecuteAsync(null);
		else
			ViewModel.SaveArticleToWebdavCommand.Execute(null);
		StateHasChanged();
	}

	public void Dispose()
	{
		if (ViewModel != null)
			ViewModel.StateChanged -= OnViewModelStateChanged;
	}
}
