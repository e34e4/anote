@using MudBlazor
@using SilentNotes.Services
@using SilentNotes.ViewModels

@inject ILanguageService LanguageService

<style type="text/css">
	.qr-root {
		background-color: #000000;
		min-height: calc(100vh - 128px);
		padding: 8px;
		color: #ffffff;
	}
	.qr-toolbar {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 2px 4px 10px 4px;
	}
	.qr-section-btn {
		border: 1px solid #2b2b2b;
		border-radius: 10px;
		background-color: #000000;
		color: #cccccc;
		font-size: 0.85rem;
		height: 40px;
		padding: 0 14px;
		cursor: pointer;
		touch-action: manipulation;
	}
	.qr-section-btn.active {
		color: #ffffff;
		border-color: var(--mud-palette-primary);
		background-color: #101010;
	}
	.qr-scan-big {
		width: 100%;
		height: 120px;
		font-size: 1.25rem;
		border: 1px dashed var(--mud-palette-primary);
		border-radius: 14px;
		background-color: #000000;
		color: var(--mud-palette-primary);
		cursor: pointer;
		touch-action: manipulation;
	}
	.qr-scan-big:active {
		background-color: #1f1f1f;
	}
	.qr-scan-big:disabled {
		color: #616161;
		border-color: #2b2b2b;
	}
	.qr-result-card {
		margin-top: 12px;
		border: 1px solid #2b2b2b;
		border-radius: 12px;
		background-color: #101010;
		padding: 12px;
	}
	.qr-result-text {
		word-break: break-all;
		white-space: pre-wrap;
		font-size: 1rem;
		margin-top: 4px;
	}
	.qr-actions {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-top: 10px;
	}
	.qr-btn {
		border: 1px solid #2b2b2b;
		border-radius: 10px;
		background-color: #000000;
		color: #ffffff;
		height: 44px;
		padding: 0 16px;
		font-size: 0.95rem;
		cursor: pointer;
		touch-action: manipulation;
	}
	.qr-btn.primary {
		color: var(--mud-palette-primary);
		border-color: var(--mud-palette-primary);
	}
	.qr-btn:active {
		background-color: #1f1f1f;
	}
	.qr-row {
		display: flex;
		align-items: center;
		padding: 10px 8px;
		border-bottom: 1px solid #202020;
	}
	.qr-row-main {
		flex-grow: 1;
		overflow: hidden;
		cursor: pointer;
	}
	.qr-row-text {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.qr-sub {
		color: #9e9e9e;
		font-size: 0.8rem;
	}
	.qr-section-title {
		color: #9e9e9e;
		font-size: 0.8rem;
		margin: 16px 4px 4px 4px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.qr-overlay {
		position: fixed;
		z-index: 1400;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		overflow-y: auto;
		background-color: #000000;
		padding: 14px;
		color: #ffffff;
	}
	.qr-overlay-header {
		display: flex;
		align-items: center;
		margin-bottom: 10px;
	}
	.qr-overlay-title {
		font-size: 1.15rem;
		font-weight: 600;
		margin-left: 4px;
	}
	.qr-preview {
		background-color: #ffffff;
		border-radius: 12px;
		padding: 12px;
		margin: 14px auto;
		width: fit-content;
	}
	.qr-preview img {
		width: 280px;
		height: 280px;
		display: block;
	}
	.qr-settings-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px 4px;
		border-bottom: 1px solid #202020;
	}
</style>

<div class="qr-root">
	<div class="qr-toolbar">
		<button class="qr-section-btn @(!ViewModel.IsHistoryView ? "active" : null)" @onclick="() => ViewModel.ShowScanViewCommand.Execute(null)">@LanguageService["qr_scan"]</button>
		<button class="qr-section-btn @(ViewModel.IsHistoryView ? "active" : null)" @onclick="() => ViewModel.ShowHistoryViewCommand.Execute(null)">@LanguageService["qr_history"]</button>
		<MudSpacer />
		<MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="() => ViewModel.ShowCreateCommand.Execute(null)" title="@LanguageService["qr_create"]" />
		<MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
			<ActivatorContent>
				<MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" />
			</ActivatorContent>
			<ChildContent>
				<MudMenuItem Icon="@Icons.Material.Filled.Image" OnClick="DecodeFromImage">@LanguageService["qr_decode_image"]</MudMenuItem>
				<MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="() => ViewModel.ShowSettingsCommand.Execute(null)">@LanguageService["qr_settings"]</MudMenuItem>
			</ChildContent>
		</MudMenu>
	</div>

	@if (!ViewModel.IsHistoryView)
	{
		@* Scan view *@
		@if (!ViewModel.IsScanSupported)
		{
			<MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@LanguageService["qr_scan_not_supported"]</MudAlert>
		}
		else if (ViewModel.NeedsCameraPermission)
		{
			<MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
				<span>@LanguageService["qr_needs_permission"]</span>
				<MudButton Size="Size.Small" Color="Color.Primary" Class="ml-2" OnClick="RequestCameraPermission">@LanguageService["qr_grant"]</MudButton>
			</MudAlert>
		}

		<button class="qr-scan-big" disabled="@(!ViewModel.IsScanSupported || ViewModel.IsBusy)" @onclick="ScanQr">
			@(ViewModel.IsBusy ? LanguageService["qr_busy"] : LanguageService["qr_scan_start"])
		</button>

		@if (ViewModel.Result != null)
		{
			<div class="qr-result-card">
				<div class="qr-sub">@LanguageService["qr_result"]</div>
				<div class="qr-result-text">@ViewModel.Result.Text</div>
				<div class="qr-actions">
					@if (ViewModel.Result.IsUrl)
					{
						<button class="qr-btn primary" @onclick="() => ViewModel.OpenItemCommand.Execute(ViewModel.Result)">@LanguageService["qr_open_link"]</button>
					}
					<button class="qr-btn" @onclick="() => ViewModel.CopyItemCommand.Execute(ViewModel.Result)">@LanguageService["qr_copy"]</button>
					<button class="qr-btn" @onclick="() => ViewModel.ShareItemCommand.Execute(ViewModel.Result)">@LanguageService["qr_share"]</button>
				</div>
			</div>
		}

		<div class="qr-section-title">@LanguageService["qr_recent"]</div>
		@if (ViewModel.PreviewItems.Count == 0)
		{
			<MudText Align="Align.Center" Class="ma-6 mud-text-secondary">@LanguageService["qr_history_empty"]</MudText>
		}
		else
		{
			@foreach (var item in ViewModel.PreviewItems)
			{
				<div class="qr-row" @key="item.Id">
					<div class="qr-row-main" @onclick="() => ViewModel.ShowResultCommand.Execute(item)">
						<div class="qr-row-text">@item.Text</div>
						<div class="qr-sub">@item.DateText</div>
					</div>
					@if (item.IsUrl)
					{
						<MudIconButton Icon="@Icons.Material.Filled.OpenInBrowser" Size="Size.Small" OnClick="@(() => ViewModel.OpenItemCommand.Execute(item))" title="@LanguageService["qr_open_link"]" />
					}
					<MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small" OnClick="@(() => ViewModel.ShareItemCommand.Execute(item))" title="@LanguageService["qr_share"]" />
					<MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => ViewModel.CopyItemCommand.Execute(item))" title="@LanguageService["qr_copy"]" />
				</div>
			}
		}
	}
	else
	{
		@* History view *@
		@if (ViewModel.Items.Count == 0)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["qr_history_empty"]</MudText>
		}
		else
		{
			<div class="qr-actions">
				<button class="qr-btn" @onclick="ClearHistory">@LanguageService["qr_history_clear"]</button>
			</div>
			@foreach (var item in ViewModel.Items)
			{
				<div class="qr-row" @key="item.Id">
					<div class="qr-row-main" @onclick="() => ViewModel.ShowResultCommand.Execute(item)">
						<div class="qr-row-text">@item.Text</div>
						<div class="qr-sub">@item.DateText</div>
					</div>
					@if (item.IsUrl)
					{
						<MudIconButton Icon="@Icons.Material.Filled.OpenInBrowser" Size="Size.Small" OnClick="@(() => ViewModel.OpenItemCommand.Execute(item))" title="@LanguageService["qr_open_link"]" />
					}
					<MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small" OnClick="@(() => ViewModel.ShareItemCommand.Execute(item))" title="@LanguageService["qr_share"]" />
					<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => ViewModel.DeleteItemCommand.Execute(item))" title="@LanguageService["qr_delete"]" />
				</div>
			}
		}
	}
</div>

@* Create overlay *@
@if (ViewModel.IsCreateVisible)
{
	<div class="qr-overlay">
		<div class="qr-overlay-header">
			<MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="() => ViewModel.CloseOverlayCommand.Execute(null)" title="@LanguageService["back"]" />
			<div class="qr-overlay-title">@LanguageService["qr_create"]</div>
		</div>

		<MudTextField T="string" @bind-Value="ViewModel.CreateText" Label="@LanguageService["qr_create_hint"]" Variant="Variant.Outlined" Lines="3" Class="mb-3" />

		<div class="qr-actions">
			<button class="qr-btn primary" disabled="@ViewModel.IsBusy" @onclick="GenerateQr">@LanguageService["qr_generate"]</button>
		</div>

		@if (ViewModel.HasQrImage)
		{
			<div class="qr-preview">
				<img src="@ViewModel.QrImageBase64" alt="QR code" />
			</div>
			<div class="qr-actions" style="justify-content: center;">
				<button class="qr-btn" @onclick="SaveQrImage">@LanguageService["qr_save_image"]</button>
				<button class="qr-btn" @onclick="() => ViewModel.ShareCreateTextCommand.Execute(null)">@LanguageService["qr_share"]</button>
				<button class="qr-btn" @onclick="() => ViewModel.CopyCreateTextCommand.Execute(null)">@LanguageService["qr_copy"]</button>
			</div>
		}
	</div>
}

@* Settings overlay *@
@if (ViewModel.IsSettingsVisible)
{
	<div class="qr-overlay">
		<div class="qr-overlay-header">
			<MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="() => ViewModel.CloseOverlayCommand.Execute(null)" title="@LanguageService["back"]" />
			<div class="qr-overlay-title">@LanguageService["qr_settings"]</div>
		</div>

		<div class="qr-settings-row">
			<span>@LanguageService["qr_vibrate_on_scan"]</span>
			<MudSwitch T="bool" @bind-Value="ViewModel.VibrateOnScan" Color="Color.Primary" />
		</div>
		<div class="qr-settings-row">
			<span>@LanguageService["qr_auto_copy"]</span>
			<MudSwitch T="bool" @bind-Value="ViewModel.AutoCopyToClipboard" Color="Color.Primary" />
		</div>
		<div class="qr-settings-row">
			<span>@LanguageService["qr_keep_history"]</span>
			<MudSwitch T="bool" @bind-Value="ViewModel.KeepHistory" Color="Color.Primary" />
		</div>
	</div>
}

@code {
	/// <summary>
	/// Gets or sets the datacontext of this view.
	/// </summary>
	[Parameter]
	public QrViewModel ViewModel { get; set; }

	private async Task ScanQr()
	{
		await ViewModel.ScanAsync();
	}

	private async Task DecodeFromImage()
	{
		await ViewModel.DecodeImageAsync();
	}

	private async Task RequestCameraPermission()
	{
		await ViewModel.RequestCameraPermissionAsync();
	}

	private async Task GenerateQr()
	{
		await ViewModel.GenerateQrAsync();
	}

	private async Task SaveQrImage()
	{
		await ViewModel.SaveQrImageAsync();
	}

	private async Task ClearHistory()
	{
		await ViewModel.ClearHistoryAsync();
	}
}
