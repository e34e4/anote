@code {
	///////////////////////////////////////////////////////////////////////////////////////////////
	private bool _isOverflowMenuOpen;
	private MudAutocomplete<string> _tagAutocomplete;
	private ElementReference _editorContainer;
	private IJSObjectReference _jsModule;
	private FormatToggleStates _formatStates;
	private bool _searchToolbarOpen;
	private MudInput<string> _searchInput;
	private bool _pendingFocusToSearchInput;
	private string _searchPattern;
	private bool _colorPaletteOpen;
	private bool _textColorDialogOpen;
	private bool _isHighlightColorMode;
	private LinkState _linkState;

	private static readonly string[] TextColorPalette = new[]
	{
		"#ff5252", "#ff7043", "#ffb300", "#ffd54f", "#66bb6a", "#26a69a",
		"#29b6f6", "#42a5f5", "#7e57c2", "#ab47bc", "#ec407a", "#f06292",
		"#ffffff", "#bdbdbd", "#78909c", "#8d6e63", "#212121", "#d32f2f",
	};

	private static readonly string[] HighlightColorPalette = new[]
	{
		"#5c1a1a", "#5c3310", "#5c4b00", "#1b4d20", "#0d4747", "#0d3c61",
		"#311b61", "#4a154b", "#ffcdd2", "#ffe0b2", "#fff9c4", "#c8e6c9",
		"#b2ebf2", "#bbdefb", "#e1bee7", "#f8bbd0", "#424242", "#cfd8dc",
	};
	private bool _allowNoteContentChanges;
	private bool _noteHasOpenableUrl;
	private bool _isPickingFile;
	private bool _sourceViewActive;
	private string _sourceText = string.Empty;
	private string _sourceHighlightHtml = string.Empty;
	private string _sourceLineNumbers = "1";
	private ElementReference _srcTextareaRef;
	private ElementReference _srcHighlightRef;
	private ElementReference _srcGutterRef;
	private IJSObjectReference _readerJsModule;
	private bool _sourceListenersAttached;
	private CancellationTokenSource _sourceHighlightCts;
	private readonly System.Text.StringBuilder _contentChunks = new System.Text.StringBuilder();
	private int _receivedContentChunks;

	protected override void OnInitialized()
	{
		_formatStates = new FormatToggleStates();
		_linkState = new LinkState();
		_allowNoteContentChanges = false;

		MessengerService.Register<KeepScreenOnChangedMessage>(
			this, (recipient, message) => OnKeepScreenOnChanged());
		MessengerService.Register<SynchronizationIsRunningChangedMessage>(
			this, (recipient, message) => _ = OnSynchronizationIsRunningChanged(message));
	}

	protected override void OnParametersSet()
	{
		BackRoute = RouteNames.Combine(RouteNames.NoteRepository, "bringtoview", NoteId);

		RepositoryStorageLoadResult loadResult = RepositoryStorageService.LoadRepositoryOrDefault(out NoteRepositoryModel noteRepository);
		if (loadResult == RepositoryStorageLoadResult.InvalidRepository)
			throw new Exception("Invalid repository");

		// Get the note from the repository
		Guid noteId = new Guid(NoteId);
		NoteModel note = noteRepository.Notes.FindById(noteId);
		ICryptor cryptor = new Cryptor(NoteModel.CryptorPackageName, CryptoRandomSource);
		ViewModel = new NoteViewModel(
			note,
			null,
			NavigationService,
			LanguageService,
			ThemeService,
			RepositoryStorageService,
			FeedbackService,
			SettingsService,
			SafeKeyService,
			EnvironmentService,
			NativeBrowserService,
			SharingService,
			SynchronizationState,
			cryptor,
			noteRepository.Safes,
			noteRepository.CollectActiveTags());

		if (ViewModel.Model == NoteModel.NotFound)
			// Redirect to home if note was not found
			NavigationService.NavigateTo(RouteNames.NoteRepository);

		_noteHasOpenableUrl = UrlActionHelpers.ContainsOpenableUrl(ViewModel.UnlockedHtmlContent);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if ((ViewModel == null) || ViewModel.IsLocked || (ViewModel.Model == NoteModel.NotFound))
			return;

		if (firstRender)
		{
			try
			{
				// Prepare prose mirror editor
				_jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Views/NotePage.razor.js");
				await _jsModule.InvokeVoidAsync("initialize", DotNetModule, ViewModel.Id.ToString(), _editorContainer, ViewModel.ShoppingModeActive);
				string content = ViewModel.UnlockedHtmlContent;
				await _jsModule.InvokeVoidAsync("setNoteContent", content);
				await _jsModule.InvokeVoidAsync("sessionLoadScrollTop", ViewModel.Id, _editorContainer);
				await _jsModule.InvokeVoidAsync("setEditable", !ViewModel.ShoppingModeActive && !SynchronizationState.IsSynchronizationRunning);
				bool isNewNote = ViewModel.SearchableContent.Trim().Length == 0;
				if (isNewNote)
					await ToggleFormatState("heading", 1);
				_allowNoteContentChanges = true;

				await KeyboardShortcuts.InitializeAsync(JSRuntime);
				KeyboardShortcuts
					.SetCloseMenuShortcut(new SnKeyboardShortcut(SnKey.Escape), OnCloseMenuOrDialog)
					.AddShortcut(new SnKeyboardShortcut(SnKey.Escape), () => Navigation.NavigateTo(BackRoute))
					.AddShortcut(new SnKeyboardShortcut("f", true), () => SearchToolbarOpen = true)
					.AddShortcut(new SnKeyboardShortcut(SnKey.F3), async () => await FindNext())
					.AddShortcut(new SnKeyboardShortcut(SnKey.F3, false, true), async () => await FindPrevious());
			}
			catch (Exception ex)
			{
				string msg = ex.Message;
			}
		}

		if (_pendingFocusToSearchInput)
		{
			_pendingFocusToSearchInput = false;
			await _searchInput.FocusAsync();
		}
	}

	protected override async ValueTask OnClosingPageAsync()
	{
		_allowNoteContentChanges = false;
		await base.OnClosingPageAsync();
		MessengerService.Unregister<SynchronizationIsRunningChangedMessage>(this);
		MessengerService.Unregister<KeepScreenOnChangedMessage>(this);
		if (_jsModule != null)
		{
			await _jsModule.InvokeVoidAsync("sessionSaveScrollTop", ViewModel.Id, _editorContainer);
			await _jsModule.InvokeVoidAsync("finalize", ViewModel?.Id.ToString());
			await _jsModule.DisposeAsync();
		}
	}

	/// <inheritdoc/>
	protected override void OnAfterResume(bool newNoteShared, bool safesClosed)
	{
		base.OnAfterResume(newNoteShared, safesClosed);

		// Returning from the file picker would reload the page and thereby discard the picture
		// which is about to be inserted.
		if (_isPickingFile)
			return;

		if ((ViewModel == null) || (ViewModel.Model == NoteModel.NotFound))
			return;

		if (ViewModel.IsLocked)
		{
			// Go to the safe open dialog
			Navigation.NavigateTo(ViewModel.Route, true);
		}
		else
		{
			Navigation.NavigateReload();
		}
	}

	private NoteViewModel ViewModel { get; set; }

	/// <summary>
	/// Gets or sets the note id which was passed in the routing.
	/// </summary>
	[Parameter]
	public string NoteId { get; set; } = default!;

	/// <inheritdoc/>
	protected override void OnStoringUnsavedData(StoreUnsavedDataMessage message)
	{
		base.OnStoringUnsavedData(message);
		if ((ViewModel == null) || ViewModel.IsLocked || (ViewModel.Model == NoteModel.NotFound))
			return;

		ViewModel.OnStoringUnsavedData(message);
	}

	/// <inheritdoc/>
	protected override bool OnCloseMenuOrDialog()
	{
		base.OnCloseMenuOrDialog();
		bool result = false;
		bool refreshNeeded = false;

		if (_isOverflowMenuOpen)
		{
			_isOverflowMenuOpen = false;
			result = true;
			refreshNeeded = true;
		}
		if (SearchToolbarOpen)
		{
			SearchToolbarOpen = false;
			result = true;
		}
		if (_colorPaletteOpen)
		{
			_colorPaletteOpen = false;
			result = true;
			refreshNeeded = true;
		}
		if (_textColorDialogOpen)
		{
			_textColorDialogOpen = false;
			result = true;
			refreshNeeded = true;
		}
		if (_linkState.IsDialogOpen)
		{
			_linkState.IsDialogOpen = false;
			result = true;
			refreshNeeded = true;
		}

		if (refreshNeeded)
			StateHasChanged();
		return result;
	}

	/// <summary>
	/// Gets or sets a value indicating whether the search toolbar is visible or not.
	/// </summary>
	private bool SearchToolbarOpen
	{
		get { return _searchToolbarOpen; }

		set
		{
			if (_searchToolbarOpen != value)
			{
				_searchToolbarOpen = value;
				if (value)
					_pendingFocusToSearchInput = true;
				StateHasChanged();
			}
		}
	}

	private string SearchPattern
	{
		get { return _searchPattern; }
		set
		{
			_searchPattern = value;
			_jsModule.InvokeVoidAsync("search", _searchPattern);
		}
	}

	private async ValueTask FindNext()
	{
		await _jsModule.InvokeVoidAsync("findNext");
	}

	private async ValueTask FindPrevious()
	{
		await _jsModule.InvokeVoidAsync("findPrevious");
	}

	/// <summary>
	/// Toggles the shopping mode and enables/disables the editor.
	/// </summary>
	/// <returns>Task for async call.</returns>
	private async ValueTask ToggleShoppingMode()
	{
		ViewModel.ShoppingModeActive = !ViewModel.ShoppingModeActive;
		await _jsModule.InvokeVoidAsync("setEditable", !ViewModel.ShoppingModeActive);
	}

	/// <summary>
	/// Sets one of the text format states.
	/// </summary>
	/// <param name="formatName">Name of the format, e.g. "bold".</param>
	/// <param name="formatParameter">Optional parameter, e.g. "header" 2.</param>
	/// <returns>Task for async call.</returns>
	private async Task ToggleFormatState(string formatName, int formatParameter = 0)
	{
		await _jsModule.InvokeVoidAsync("toggleFormatAndRefresh", formatName, formatParameter);
	}

	/// <summary>
	/// Inserts a horizontal rule.
	/// </summary>
	/// <returns>Task for async call.</returns>
	private async Task InsertHorizontalRule()
	{
		await _jsModule.InvokeVoidAsync("callInsertHorizontalRule");
	}

	private async Task InvokeTableCommand(string commandName)
	{
		await _jsModule.InvokeVoidAsync(commandName);
	}

	private async Task OpenTextColorDialog()
	{
		if (ViewModel.ShoppingModeActive)
			return;
		_isOverflowMenuOpen = false;
		if (_jsModule != null)
			await _jsModule.InvokeVoidAsync("rememberSelectionForColor");
		_textColorDialogOpen = true;
		StateHasChanged();
	}

	private async Task ApplyLineOrSelectionColorAsync(string colorHex)
	{
		if (_jsModule != null)
		{
			await _jsModule.InvokeVoidAsync("applyLineOrSelectionColor", colorHex, _isHighlightColorMode);
		}
		_textColorDialogOpen = false;
		StateHasChanged();
	}

	private async Task ClearLineOrSelectionColorAsync()
	{
		if (_jsModule != null)
		{
			await _jsModule.InvokeVoidAsync("clearLineOrSelectionColor", _isHighlightColorMode);
		}
		_textColorDialogOpen = false;
		StateHasChanged();
	}

	/// <summary>
	/// Lets the user pick a picture and inserts it into the note.
	/// </summary>
	/// <returns>Task for async call.</returns>
	private async Task InsertImage()
	{
		if (ViewModel.ShoppingModeActive)
			return;

		// While the picker is open, the application is paused and resumed. The resume must not
		// reload the page, otherwise the picture which is inserted afterwards would be lost.
		_isPickingFile = true;
		try
		{
			if (!await FilePickerService.PickImage())
				return;

			byte[] bytes = await FilePickerService.ReadPickedFile();
			if ((bytes == null) || (bytes.Length == 0))
			{
				FeedbackService.ShowToast(LanguageService["note_image_failed"], FeedbackSeverity.Warning);
				return;
			}

			string status = await _jsModule.InvokeAsync<string>("insertImageFromBase64", Convert.ToBase64String(bytes));
			if (!string.Equals(status, "ok", StringComparison.Ordinal) && !string.Equals(status, "ok-unscaled", StringComparison.Ordinal))
				FeedbackService.ShowToast(LanguageService["note_image_failed"] + " (" + status + ")", FeedbackSeverity.Warning);
		}
		catch (Exception)
		{
			FeedbackService.ShowToast(LanguageService["note_image_failed"], FeedbackSeverity.Warning);
		}
		finally
		{
			_isPickingFile = false;
		}
	}

	private async Task ShareNote()
	{
		string plainText = await _jsModule.InvokeAsync<string>("getAsPlainText");
		ViewModel.ShareNoteCommand.Execute(plainText);
	}

	private async Task SaveNoteToWebdavAsync()
	{
		if (!WebdavQuickSaveService.IsConfigured)
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_not_configured"], FeedbackSeverity.Warning);
			return;
		}

		string plainText = null;
		try
		{
			plainText = await _jsModule.InvokeAsync<string>("getAsPlainText");
		}
		catch (Exception)
		{
			plainText = ViewModel?.SearchableContent;
		}

		if (string.IsNullOrWhiteSpace(plainText))
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_empty"], FeedbackSeverity.Warning);
			return;
		}

		bool ok = await WebdavQuickSaveService.SaveTextAsync("Notes", plainText);
		if (ok)
			FeedbackService.ShowToast(LanguageService.LoadTextFmt("webdav_quick_saved", WebdavQuickSaveService.LastFileName));
		else
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"] + " — " + WebdavQuickSaveService.LastError, FeedbackSeverity.Warning);
	}

	[JSInvokable("OpenLinkDialog")]
	public async Task OpenLinkDialog()
	{
		if (ViewModel.ShoppingModeActive)
			return;

		string[] urls = await _jsModule.InvokeAsync<string[]>("prepareLinkDialog");
		_linkState.LinkUrl = urls[0];
		_linkState.OldLinkUrl = _linkState.LinkUrl;
		_linkState.LinkTitle = urls[1];
		_linkState.OldLinkTitle = _linkState.LinkTitle;

		if (string.IsNullOrEmpty(_linkState.LinkUrl))
			_linkState.LinkUrl = MakeLinkSuggestion(_linkState.LinkTitle);

		_linkState.IsDialogOpen = true;
		StateHasChanged();
	}

	public async Task LinkDialogOkPressed()
	{
		bool isValidLinkTitle = !string.IsNullOrWhiteSpace(_linkState.LinkTitle);
		bool isValidLinkUrl = string.IsNullOrEmpty(_linkState.LinkUrl) || WebviewUtils.IsExternalUri(_linkState.LinkUrl);
		if (isValidLinkTitle && isValidLinkUrl)
		{
			await _jsModule.InvokeVoidAsync("linkDialogOkPressed",
				_linkState.OldLinkUrl, _linkState.LinkUrl, _linkState.OldLinkTitle, _linkState.LinkTitle);
			_linkState.IsDialogOpen = false;
		}
	}

	public void LinkDialogLinkClicked(string linkUrl)
	{
		_linkState.IsDialogOpen = false;
		ViewModel.OpenLinkCommand.Execute(linkUrl);
	}

	private void OnKeepScreenOnChanged()
	{
		ViewModel.KeepScreenOnActive = EnvironmentService.KeepScreenOn.IsActive;
	}

	private async Task OnSynchronizationIsRunningChanged(SynchronizationIsRunningChangedMessage message)
	{
		if (_jsModule != null)
			await _jsModule.InvokeVoidAsync("setEditable", !ViewModel.ShoppingModeActive);
		await InvokeAsync(StateHasChanged);
	}

	private static string MakeLinkSuggestion(string linkTitle)
	{
		linkTitle = linkTitle.Trim();
		if (WebviewUtils.IsExternalUri(linkTitle))
			return linkTitle;
		else if (WebviewUtils.IsExternalUri("https://" + linkTitle))
			return "https://" + linkTitle;
		else
			return "https://";
	}

	private async Task NewTagChanged(string value)
	{
		if (!string.IsNullOrWhiteSpace(value))
		{
			ViewModel.AddTagCommand.Execute(value);
			await _tagAutocomplete.ResetAsync();
		}
	}

	private Task<IEnumerable<string>> GetNewTagSuggestions(string value, CancellationToken token)
	{
		// If text is null or empty, show complete list
		if (string.IsNullOrWhiteSpace(value))
			return Task.FromResult(ViewModel.TagSuggestions);

		// Search suggestions for matches
		var result = ViewModel.TagSuggestions.Where(t => t.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();

		// Add current user input as tag, so it can be selected as well
		if (!result.Contains(value, StringComparer.InvariantCultureIgnoreCase))
			result.Insert(0, value);

		return Task.FromResult(result.AsEnumerable());
	}

	/// <summary>
	/// Called from the javascript to update all format states in the GUI.
	/// This method is e.g. called when the text cursor has moved to a new position.
	/// </summary>
	/// <param name="states">Array containing the state of all formats.</param>
	[JSInvokable("RefreshActiveFormatState")]
	public void RefreshActiveFormatState(bool[] states)
	{
		_formatStates.LoadFromJsArray(states);
		StateHasChanged();
	}

	/// <summary>
	/// Called from the javascript to update the content of the note.
	/// </summary>
	/// <param name="content">String containing the html note content.</param>
	[JSInvokable("SetNoteContent")]
	public void SetNoteContent(string content)
	{
		ApplyNoteContent(content);
	}

	/// <summary>
	/// Called from the javascript with a part of the note content. Large notes are transferred in
	/// several chunks, because a single js to .net message has a maximum size.
	/// </summary>
	/// <param name="index">The zero based index of the transferred part.</param>
	/// <param name="total">The total number of parts.</param>
	/// <param name="part">The html content of this part.</param>
	[JSInvokable("SetNoteContentChunk")]
	public void SetNoteContentChunk(int index, int total, string part)
	{
		if (index == 0)
		{
			_contentChunks.Clear();
			_receivedContentChunks = 0;
		}

		_contentChunks.Append(part);
		_receivedContentChunks++;

		if (_receivedContentChunks >= total)
		{
			string content = _contentChunks.ToString();
			_contentChunks.Clear();
			ApplyNoteContent(content);
		}
	}

	private void ApplyNoteContent(string content)
	{
		// The _allowNoteContentChanges guarantees, that changes are only processed after all the
		// initialization steps are completed, so premature events can never damage the note content.
		if (!_allowNoteContentChanges)
			return;
		ViewModel.UnlockedHtmlContent = content;
		RefreshNoteOpenableUrl(content);
	}

	private void RefreshNoteOpenableUrl(string content)
	{
		bool next = UrlActionHelpers.ContainsOpenableUrl(content);
		if (next == _noteHasOpenableUrl)
			return;
		_noteHasOpenableUrl = next;
		_ = InvokeAsync(StateHasChanged);
	}

	private async Task OpenFirstLinkFromNoteAsync()
	{
		string plainText = null;
		try
		{
			if (_jsModule != null)
				plainText = await _jsModule.InvokeAsync<string>("getAsPlainText");
		}
		catch (Exception)
		{
		}

		if (!UrlActionHelpers.TryGetFirstOpenableUrl(plainText, out _))
			UrlActionHelpers.OpenFirstUrl(NativeBrowserService, ViewModel.UnlockedHtmlContent);
		else
			UrlActionHelpers.OpenFirstUrl(NativeBrowserService, plainText);
	}

	private async Task ToggleSourceViewAsync()
	{
		if (ViewModel.ShoppingModeActive)
			return;

		if (_sourceViewActive)
		{
			await ApplySourceToEditorAsync();
			_sourceViewActive = false;
			StateHasChanged();
			return;
		}

		string html = ViewModel.UnlockedHtmlContent ?? string.Empty;
		try
		{
			if (_jsModule != null)
				html = await _jsModule.InvokeAsync<string>("getHtml") ?? html;
		}
		catch
		{
		}

		_sourceText = html ?? string.Empty;
		RefreshSourceHighlight();
		_sourceViewActive = true;
		StateHasChanged();
		await Task.Yield();
		await EnsureSourceEditorReadyAsync();
	}

	private async Task EnsureSourceEditorReadyAsync()
	{
		try
		{
			_readerJsModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./reader-text-editor.js");
			await _readerJsModule.InvokeVoidAsync("setTextareaValue", _srcTextareaRef, _sourceText);
			await _readerJsModule.InvokeVoidAsync("setOverlay", _srcHighlightRef, _srcGutterRef, _sourceHighlightHtml, _sourceLineNumbers);
			if (!_sourceListenersAttached)
			{
				await _readerJsModule.InvokeVoidAsync("attachEditorListeners", _srcTextareaRef, _srcHighlightRef, _srcGutterRef, null);
				_sourceListenersAttached = true;
			}
		}
		catch
		{
		}
	}

	private void OnSourceInput(ChangeEventArgs e)
	{
		_sourceText = e?.Value?.ToString() ?? string.Empty;
		ScheduleSourceHighlight();
	}

	private async Task OnSourceBlurAsync()
	{
		await ApplySourceToEditorAsync();
	}

	private async Task ApplySourceToEditorAsync()
	{
		string html = _sourceText ?? string.Empty;
		ViewModel.UnlockedHtmlContent = html;
		RefreshNoteOpenableUrl(html);
		try
		{
			if (_jsModule != null)
				await _jsModule.InvokeVoidAsync("setNoteContent", html);
		}
		catch
		{
		}
	}

	private void ScheduleSourceHighlight()
	{
		_sourceHighlightCts?.Cancel();
		_sourceHighlightCts = new CancellationTokenSource();
		CancellationToken token = _sourceHighlightCts.Token;
		_ = Task.Run(async () =>
		{
			try
			{
				await Task.Delay(80, token);
				if (token.IsCancellationRequested)
					return;
				await InvokeAsync(async () =>
				{
					RefreshSourceHighlight();
					if (_readerJsModule != null)
					{
						await _readerJsModule.InvokeVoidAsync(
							"setOverlay", _srcHighlightRef, _srcGutterRef, _sourceHighlightHtml, _sourceLineNumbers);
					}
				});
			}
			catch (TaskCanceledException)
			{
			}
		});
	}

	private void RefreshSourceHighlight()
	{
		_sourceHighlightHtml = ReaderSyntaxHighlighter.ToHighlightedHtml(_sourceText, "html");
		int lines = 1;
		string text = _sourceText ?? string.Empty;
		for (int i = 0; i < text.Length; i++)
		{
			if (text[i] == '\n')
				lines++;
		}
		if (string.IsNullOrEmpty(text))
			lines = 1;
		var sb = new System.Text.StringBuilder(lines * 4);
		for (int i = 1; i <= lines; i++)
		{
			if (i > 1)
				sb.Append('\n');
			sb.Append(i);
		}
		_sourceLineNumbers = sb.ToString();
	}
}
