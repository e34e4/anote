@using MudBlazor
@using SilentNotes.Services
@using SilentNotes.ViewModels
@implements IDisposable

@inject ILanguageService LanguageService
@inject IMessengerService MessengerService
@inject IScrollManager ScrollManager
@inject IWebdavQuickSaveService WebdavQuickSaveService
@inject ISharingService SharingService
@inject IFeedbackService FeedbackService

<style type="text/css">
	.sms-root {
		background-color: #000000;
		min-height: calc(100vh - 128px);
		padding: 8px;
		color: #ffffff;
	}
	.sms-toolbar {
		display: flex;
		align-items: center;
		padding: 0 4px 4px 4px;
	}
	.sms-thread-row {
		display: flex;
		align-items: center;
		padding: 10px 0 10px 8px;
		border-bottom: 1px solid #202020;
	}
	.sms-thread-main {
		flex-grow: 1;
		overflow: hidden;
		cursor: pointer;
	}
	.sms-thread-title {
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sms-thread-snippet {
		color: #9e9e9e;
		font-size: 0.85rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sms-thread-side {
		text-align: right;
		margin-left: 8px;
		flex-shrink: 0;
	}
	.sms-unread {
		display: inline-block;
		min-width: 20px;
		height: 20px;
		line-height: 20px;
		border-radius: 10px;
		padding: 0 6px;
		background-color: var(--mud-palette-primary);
		color: var(--mud-palette-primary-text);
		font-size: 0.75rem;
		text-align: center;
	}
	.sms-conv-header {
		display: flex;
		align-items: center;
		padding: 6px 4px 10px 4px;
	}
	.sms-conv-title {
		font-size: 1.15rem;
		font-weight: 600;
		margin-left: 4px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.sms-messages {
		overflow-y: auto;
		max-height: calc(100vh - 340px);
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 4px;
	}
	.sms-bubble {
		max-width: 82%;
		padding: 8px 12px;
		border-radius: 14px;
		background-color: #1c1c1c;
		color: #ffffff;
		word-break: break-word;
		white-space: pre-wrap;
		cursor: pointer;
	}
	.sms-bubble.in {
		align-self: flex-start;
		border-bottom-left-radius: 4px;
	}
	.sms-bubble.out {
		align-self: flex-end;
		background-color: #14472f;
		border-bottom-right-radius: 4px;
	}
	.sms-bubble.sel {
		outline: 2px solid var(--mud-palette-primary);
	}
	.sms-bubble-row {
		display: flex;
		align-items: flex-start;
		gap: 6px;
	}
	.sms-message-wrap {
		display: flex;
		align-items: flex-start;
		gap: 4px;
		max-width: 100%;
	}
	.sms-message-wrap.in {
		align-self: flex-start;
		flex-direction: row;
	}
	.sms-message-wrap.out {
		align-self: flex-end;
		flex-direction: row;
	}
	.sms-message-actions {
		display: flex;
		flex-direction: column;
		gap: 0;
		flex-shrink: 0;
		padding-top: 2px;
	}
	.sms-bubble-time {
		font-size: 0.7rem;
		color: #9e9e9e;
		margin-top: 2px;
		text-align: right;
	}
	.sms-composer {
		display: flex;
		align-items: flex-end;
		gap: 6px;
		margin-top: 10px;
	}
</style>

<div class="sms-root">
	@if (!ViewModel.IsSupported)
	{
		<MudAlert Severity="Severity.Info" Dense="true">@LanguageService["sms_not_supported"]</MudAlert>
	}
	else if (ViewModel.NeedsPermission)
	{
		<MudAlert Severity="Severity.Warning" Dense="true">
			<span>@LanguageService["sms_needs_permission"]</span>
			<MudButton Size="Size.Small" Color="Color.Primary" Class="ml-2" OnClick="GrantPermissionAsync">@LanguageService["sms_grant"]</MudButton>
		</MudAlert>
	}
	else if (ViewModel.IsConversationOpen)
	{
		<div class="sms-conv-header">
			@if (ViewModel.IsSelectionMode)
			{
				<MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="CancelSelection" title="@LanguageService["cancel"]" />
				<div class="sms-conv-title">@ViewModel.SelectionText</div>
				<MudSpacer />
				<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Inherit" Disabled="@(!ViewModel.HasSelection)" OnClick="DeleteSelected" title="@LanguageService["sms_delete"]" />
			}
			else
			{
				<MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="() => ViewModel.CloseConversationCommand.Execute(null)" title="@LanguageService["back"]" />
				<div class="sms-conv-title">@ViewModel.ConversationTitle</div>
				<MudSpacer />
				@if (ViewModel.Messages.Count > 0)
				{
					<MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Success" OnClick="SaveConversationToWebdavAsync" title="@LanguageService["webdav_quick_save"]" />
					<MudIconButton Icon="@Icons.Material.Filled.Checklist" Color="Color.Inherit" OnClick="() => ViewModel.StartSelectionCommand.Execute(null)" title="@LanguageService["sms_select"]" />
				}
			}
		</div>

		@if (ViewModel.IsNewConversation && !ViewModel.IsSelectionMode)
		{
			<MudTextField T="string" @bind-Value="ViewModel.OpenAddress" Label="@LanguageService["sms_to"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
		}

		@if (ViewModel.NeedsDefaultApp)
		{
			<MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
				<span>@LanguageService["sms_needs_default"]</span>
				<MudButton Size="Size.Small" Color="Color.Primary" Class="ml-2" OnClick="SetDefaultAsync">@LanguageService["sms_set_default"]</MudButton>
			</MudAlert>
		}

		<div class="sms-messages">
			@if (ViewModel.HasNoMessages)
			{
				<MudText Align="Align.Center" Class="ma-6 mud-text-secondary">@LanguageService["sms_thread_empty"]</MudText>
			}
			else
			{
				@foreach (var message in ViewModel.Messages)
				{
					<div class="sms-message-wrap @(message.IsIncoming ? "in" : "out")" @key="message.Model.Id">
						<div class="sms-bubble @(message.IsIncoming ? "in" : "out") @(ViewModel.IsSelected(message) ? "sel" : null)"
							@onclick="() => OnMessageClick(message)"
							@oncontextmenu="() => ViewModel.SelectMessage(message)"
							@oncontextmenu:preventDefault="true">
							<div class="sms-bubble-row">
								@if (ViewModel.IsSelectionMode)
								{
									<MudIcon Icon="@(ViewModel.IsSelected(message) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" Size="Size.Small" Class="mt-1" />
								}
								<div>@message.Body</div>
							</div>
							<div class="sms-bubble-time">@message.TimeText</div>
						</div>
						@if (!ViewModel.IsSelectionMode)
						{
							<div class="sms-message-actions">
								<MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Success" Size="Size.Small"
									OnClick="() => SaveMessageToWebdavAsync(message)" title="@LanguageService["webdav_quick_save"]" />
								<MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small"
									OnClick="() => ShareMessageAsync(message)" title="@LanguageService["share"]" />
							</div>
						}
					</div>
				}
			}
		</div>

		@if (!ViewModel.IsSelectionMode)
		{
			<div class="sms-composer">
				<MudTextField T="string" @bind-Value="ViewModel.ComposerText" Placeholder="@LanguageService["sms_type_message"]"
					Variant="Variant.Outlined" Margin="Margin.Dense" Lines="1" Class="flex-grow-1" Immediate="true" />
				<MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" Disabled="@(!ViewModel.CanSend)" OnClick="SendAsync" title="@LanguageService["sms_send"]" />
			</div>
		}
	}
	else
	{
		<div class="sms-toolbar">
			@if (!ViewModel.IsEmpty)
			{
				<MudText Typo="Typo.caption" Class="mud-text-secondary">@ViewModel.CountText</MudText>
			}
			<MudSpacer />
			@if (!ViewModel.IsEmpty && !ViewModel.HasNoMatches)
			{
				<MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="MarkAllRead">@LanguageService["sms_mark_all_read"]</MudButton>
			}
			<MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => ViewModel.ComposeNewCommand.Execute(null)">@LanguageService["sms_new_sms"]</MudButton>
		</div>

		@if (ViewModel.IsEmpty)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["sms_empty"]</MudText>
		}
		else if (ViewModel.HasNoMatches)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["sms_no_matches"]</MudText>
		}
		else
		{
			@foreach (var thread in ViewModel.FilteredThreads)
			{
				<div class="sms-thread-row" @key="thread.Model.ThreadId">
					<div class="sms-thread-main" @onclick="() => ViewModel.OpenThreadCommand.Execute(thread)">
						<div class="sms-thread-title">@thread.Title</div>
						<div class="sms-thread-snippet">@thread.Snippet</div>
					</div>
					<div class="sms-thread-side">
						<div class="sms-thread-snippet">@thread.TimeText</div>
						@if (thread.HasUnread)
						{
							<div class="sms-unread mt-1">@thread.Model.UnreadCount</div>
						}
					</div>
					<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => DeleteThread(thread)" title="@LanguageService["sms_delete"]" />
				</div>
			}
		}

		@if (ViewModel.NeedsDefaultApp)
		{
			<MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
				<span>@LanguageService["sms_needs_default"]</span>
				<MudButton Size="Size.Small" Color="Color.Primary" Class="ml-2" OnClick="SetDefaultAsync">@LanguageService["sms_set_default"]</MudButton>
			</MudAlert>
		}
	}
</div>

@code {
	/// <summary>
	/// Gets or sets the view model of the sms tab.
	/// </summary>
	[Parameter]
	public SmsViewModel ViewModel { get; set; }

	private int _lastMessageCount = -1;

	/// <inheritdoc/>
	protected override async Task OnInitializedAsync()
	{
		MessengerService.Register<AfterResumeMessage>(this, (recipient, message) => InvokeAsync(RefreshState));
		await ViewModel.InitializeAsync();
	}

	/// <inheritdoc/>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// Newest messages are at the top — keep the top of the thread in view.
		int count = ViewModel.IsConversationOpen ? ViewModel.Messages.Count : -1;
		if (ViewModel.IsConversationOpen && (count != _lastMessageCount))
		{
			_lastMessageCount = count;
			try
			{
				await ScrollManager.ScrollToAsync(".sms-messages", 0, 0, ScrollBehavior.Auto);
			}
			catch (Exception)
			{
			}
		}
		else if (!ViewModel.IsConversationOpen)
		{
			_lastMessageCount = -1;
		}
	}

	private void RefreshState()
	{
		ViewModel.RefreshState();
		StateHasChanged();
	}

	private void OnMessageClick(SmsMessageItemViewModel message)
	{
		// A tap only selects while the selection mode is active, a long press (context menu)
		// starts the selection mode.
		if (ViewModel.IsSelectionMode)
			ViewModel.ToggleSelectionCommand.Execute(message);
	}

	private void CancelSelection()
	{
		ViewModel.CancelSelectionCommand.Execute(null);
	}

	private async Task GrantPermissionAsync()
	{
		await ViewModel.GrantPermissionAsync();
		StateHasChanged();
	}

	private async Task SetDefaultAsync()
	{
		await ViewModel.SetDefaultAppAsync();
		StateHasChanged();
	}

	private async Task SendAsync()
	{
		await ViewModel.SendAsync();
		StateHasChanged();
	}

	private async Task DeleteThread(SmsThreadItemViewModel thread)
	{
		await ViewModel.DeleteThreadAsync(thread);
		StateHasChanged();
	}

	private async Task MarkAllRead()
	{
		await ViewModel.MarkAllReadAsync();
		StateHasChanged();
	}

	private async Task DeleteSelected()
	{
		await ViewModel.DeleteSelectedAsync();
		StateHasChanged();
	}

	private async Task SaveConversationToWebdavAsync()
	{
		if (!WebdavQuickSaveService.IsConfigured)
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_not_configured"], FeedbackSeverity.Warning);
			return;
		}
		if (ViewModel.Messages == null || ViewModel.Messages.Count == 0)
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_empty"], FeedbackSeverity.Warning);
			return;
		}

		var sb = new System.Text.StringBuilder();
		sb.AppendLine(ViewModel.ConversationTitle ?? string.Empty);
		sb.AppendLine(new string('-', 40));
		foreach (var message in ViewModel.Messages)
		{
			string direction = message.IsIncoming ? "←" : "→";
			sb.Append(message.TimeText).Append(' ').Append(direction).Append(' ').AppendLine(message.Body ?? string.Empty);
		}

		bool ok = await WebdavQuickSaveService.SaveTextAsync("Sms", sb.ToString());
		if (ok)
			FeedbackService.ShowToast(LanguageService.LoadTextFmt("webdav_quick_saved", WebdavQuickSaveService.LastFileName));
		else
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"] + " — " + WebdavQuickSaveService.LastError, FeedbackSeverity.Warning);
	}

	private async Task SaveMessageToWebdavAsync(SmsMessageItemViewModel message)
	{
		if (message == null)
			return;
		if (!WebdavQuickSaveService.IsConfigured)
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_not_configured"], FeedbackSeverity.Warning);
			return;
		}

		string direction = message.IsIncoming ? "←" : "→";
		string text = string.Format(
			"{0}\n{1}\n{2} {3}\n{4}",
			ViewModel.ConversationTitle ?? string.Empty,
			new string('-', 40),
			message.TimeText,
			direction,
			message.Body ?? string.Empty);

		bool ok = await WebdavQuickSaveService.SaveTextAsync("Sms", text);
		if (ok)
			FeedbackService.ShowToast(LanguageService.LoadTextFmt("webdav_quick_saved", WebdavQuickSaveService.LastFileName));
		else
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"] + " — " + WebdavQuickSaveService.LastError, FeedbackSeverity.Warning);
	}

	private async Task ShareMessageAsync(SmsMessageItemViewModel message)
	{
		if (message == null || string.IsNullOrEmpty(message.Body))
			return;
		await SharingService.ShareText(message.Body);
	}

	/// <inheritdoc/>
	public void Dispose()
	{
		MessengerService.Unregister<AfterResumeMessage>(this);
	}
}
