@attribute [Route(RouteNames.AiProviders)]
@inherits PageBase

@using MudBlazor
@using SilentNotes.Models
@using SilentNotes.Services
@using SilentNotes.ViewModels

@inject ILanguageService LanguageService
@inject ISvgIconService IconService
@inject IAbroAiStoreService AbroAiStoreService
@inject IAbroAiSyncService AbroAiSyncService
@inject IFeedbackService FeedbackService
@inject INavigationService Navigation

<MudAppBar Class="flex-none" Fixed="true" Dense="true" WrapContent="false">
	<MudIconButton OnClick="@(() => Navigation.NavigateTo(BackRoute))" Icon="@IconService[IconNames.ArrowLeft]" Color="Color.Inherit" title="@LanguageService["back"]" Edge="Edge.Start" />
</MudAppBar>

<MudIcon Class="background-icon" Icon="@IconService[IconNames.Settings]" Style="@($"right:-128px; top:-154px;")" />

<MudMainContent>
	<MudContainer Class="ms-0" MaxWidth="MaxWidth.Small">
		<div id="content" class="py-3">
			<h2 class="h-colored">@LanguageService["ai_providers_title"]</h2>
			<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@LanguageService["ai_providers_desc"]</MudText>

			<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
				Class="mb-4" OnClick="@(() => ViewModel.AddProviderCommand.Execute(null))">
				@LanguageService["ai_providers_add"]
			</MudButton>

			@if (ViewModel.Providers.Count == 0)
			{
				<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["ai_providers_empty"]</MudText>
			}
			else
			{
				<MudStack Spacing="1">
					@foreach (var provider in ViewModel.Providers)
					{
						bool isDefault = ViewModel.DefaultProviderId == provider.Id;
						<MudPaper Class="px-3 py-2" Elevation="1">
							<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
								<div class="overflow-hidden">
									<MudText Typo="Typo.subtitle1">
										@if (isDefault)
										{
											<MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Tertiary" Class="mr-1" />
										}
										@(provider.Name ?? LanguageService["ai_providers_unnamed"])
									</MudText>
									<MudText Typo="Typo.caption" Class="mud-text-secondary">@provider.ModelId</MudText>
									<MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate">@provider.Url</MudText>
								</div>
								<MudStack Row="true" Spacing="0">
									@if (!isDefault)
									{
										<MudIconButton Icon="@Icons.Material.Outlined.StarBorder" Color="Color.Inherit"
											title="@LanguageService["ai_providers_set_default"]"
											OnClick="@(() => ViewModel.SetDefault(provider.Id))" />
									}
									<MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Inherit"
										title="@LanguageService["rss_edit"]"
										OnClick="@(() => ViewModel.StartEditProvider(provider))" />
									<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Inherit"
										title="@LanguageService["delete"]"
										OnClick="@(() => ViewModel.DeleteProvider(provider.Id))" />
								</MudStack>
							</MudStack>
						</MudPaper>
					}
				</MudStack>
			}

			<h2 class="h-colored mt-10">@LanguageService["ai_sync_title"]</h2>
			<MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">@LanguageService["ai_sync_desc"]</MudText>
			<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
				<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync"
					Disabled="@(!ViewModel.CanSyncAi)"
					OnClick="@(() => ViewModel.SyncNowCommand.Execute(null))">
					@LanguageService["ai_sync_now"]
				</MudButton>
				<MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.CloudUpload"
					Disabled="@(!ViewModel.CanSyncAi)"
					OnClick="@(() => ViewModel.OverwriteRemoteCommand.Execute(null))">
					@LanguageService["ai_sync_overwrite"]
				</MudButton>
			</MudStack>
		</div>
	</MudContainer>
</MudMainContent>

@if (ViewModel.IsEditorOpen)
{
	<MudOverlay Visible="true" DarkBackground="true" ZIndex="1300" />
	<div class="pa-4" style="position:fixed; z-index:1400; top:10%; left:0; right:0;">
		<MudPaper Elevation="4" Class="pa-4 mx-auto" MaxWidth="480px">
			<MudText Typo="Typo.h6" Class="mb-3">
				@(ViewModel.IsEditing ? LanguageService["ai_providers_edit"] : LanguageService["ai_providers_add"])
			</MudText>
			<MudTextField @bind-Value="ViewModel.EditName" Label="@LanguageService["ai_providers_name"]" Variant="Variant.Outlined" Class="mb-3" />
			<MudTextField @bind-Value="ViewModel.EditUrl" Label="@LanguageService["ai_providers_url"]" Variant="Variant.Outlined" Class="mb-3"
				Placeholder="https://api.example.com/v1" />
			<MudTextField @bind-Value="ViewModel.EditModelId" Label="@LanguageService["ai_providers_model"]" Variant="Variant.Outlined" Class="mb-3" />
			<MudTextField @bind-Value="ViewModel.EditApiKey" Label="@LanguageService["ai_providers_api_key"]" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" />
			<MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
				<MudButton Variant="Variant.Text" OnClick="@(() => ViewModel.CancelEditor())">@LanguageService["cancel"]</MudButton>
				<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveProvider">@LanguageService["save"]</MudButton>
			</MudStack>
		</MudPaper>
	</div>
}

@code {
	private AiProvidersSettingsViewModel ViewModel { get; set; }

	protected override void OnInitialized()
	{
		BackRoute = RouteNames.Settings;
		ViewModel = new AiProvidersSettingsViewModel(AbroAiStoreService, AbroAiSyncService, FeedbackService, LanguageService);
	}

	private void SaveProvider()
	{
		if (ViewModel.TrySaveEditor())
			StateHasChanged();
	}
}
