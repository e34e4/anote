@using System
@using System.Security
@using System.Threading
@using MudBlazor
@using SilentNotes.Services
@using SilentNotes.ViewModels

@inject ILanguageService LanguageService
@implements IDisposable

<style type="text/css">
	.password-list {
		overflow-y: auto;
		max-height: calc(100vh - 340px);
	}
	.theme-dark .password-card {
		background-color: #000000;
	}
	.password-totp {
		font-family: ui-monospace, "Cascadia Code", monospace;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.08em;
	}
	.password-uri {
		color: var(--mud-palette-text-secondary);
		font-size: 0.85rem;
		word-break: break-all;
	}
</style>

<div class="pa-2">
	@if (ViewModel == null)
	{
		<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">…</MudText>
	}
	else if (ViewModel.NeedsSetup)
	{
		<MudPaper Class="pa-4 ma-2" Elevation="1">
			<MudText Typo="Typo.h6" Class="mb-2">@LanguageService["password_setup_title"]</MudText>
			<MudText Class="mb-4 mud-text-secondary">@LanguageService["password_setup_hint"]</MudText>
			<MudForm>
				<MudTextFieldEx T="SecureString" @bind-Value="ViewModel.MasterPassword"
					Label="@LanguageService["password_master"]"
					Converter="@_secureStringConverter"
					Variant="Variant.Outlined" InputType="@_passwordInputType"
					Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon"
					OnAdornmentClick="@(() => _passwordVisible = !_passwordVisible)" />
				<MudTextFieldEx T="SecureString" @bind-Value="ViewModel.MasterPasswordConfirmation"
					Label="@LanguageService["safe_confirm_password"]"
					Converter="@_secureStringConverter"
					Variant="Variant.Outlined" InputType="@_passwordInputType" Class="mt-2" />
			</MudForm>
			@if (!string.IsNullOrEmpty(ViewModel.ErrorText))
			{
				<MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@ViewModel.ErrorText</MudAlert>
			}
			<MudButton Class="mt-3" Color="Color.Primary" Variant="Variant.Filled"
				OnClick="@(() => ViewModel.CreateVaultCommand.Execute(null))">@LanguageService["password_create_vault"]</MudButton>
		</MudPaper>
	}
	else if (ViewModel.NeedsUnlock)
	{
		<MudPaper Class="pa-4 ma-2" Elevation="1">
			<MudText Typo="Typo.h6" Class="mb-2">@LanguageService["password_unlock_title"]</MudText>
			@if (ViewModel.HasPin)
			{
				<MudText Class="mb-2 mud-text-secondary">@LanguageService["password_unlock_pin_hint"]</MudText>
				<MudTextFieldEx T="SecureString" @bind-Value="ViewModel.Pin"
					Label="@LanguageService["password_pin"]"
					Converter="@_secureStringConverter"
					Variant="Variant.Outlined" InputType="InputType.Password" />
				<MudButton Class="mt-2" Color="Color.Primary" Variant="Variant.Filled"
					OnClick="@(() => ViewModel.UnlockPinCommand.Execute(null))">@LanguageService["password_unlock_pin"]</MudButton>
				<MudDivider Class="my-4" />
			}
			<MudTextFieldEx T="SecureString" @bind-Value="ViewModel.MasterPassword"
				Label="@LanguageService["password_master"]"
				Converter="@_secureStringConverter"
				Variant="Variant.Outlined" InputType="@_passwordInputType"
				Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon"
				OnAdornmentClick="@(() => _passwordVisible = !_passwordVisible)" />
			@if (!string.IsNullOrEmpty(ViewModel.ErrorText))
			{
				<MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@ViewModel.ErrorText</MudAlert>
			}
			<MudButton Class="mt-3" Color="Color.Primary" Variant="Variant.Filled"
				OnClick="@(() => ViewModel.UnlockMasterCommand.Execute(null))">@LanguageService["password_unlock_master"]</MudButton>
		</MudPaper>
	}
	else
	{
		@if (ViewModel.ShowPinSetup)
		{
			<MudPaper Class="pa-3 mb-2" Elevation="1">
				<MudText Typo="Typo.subtitle1">@LanguageService["password_pin_setup"]</MudText>
				<MudTextFieldEx T="SecureString" @bind-Value="ViewModel.Pin"
					Label="@LanguageService["password_pin"]"
					Converter="@_secureStringConverter"
					Variant="Variant.Outlined" InputType="InputType.Password" Class="mt-2" />
				<MudTextFieldEx T="SecureString" @bind-Value="ViewModel.PinConfirmation"
					Label="@LanguageService["password_pin_confirm"]"
					Converter="@_secureStringConverter"
					Variant="Variant.Outlined" InputType="InputType.Password" Class="mt-2" />
				@if (!string.IsNullOrEmpty(ViewModel.ErrorText))
				{
					<MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@ViewModel.ErrorText</MudAlert>
				}
				<MudStack Row="true" Class="mt-2" Spacing="1">
					<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => ViewModel.SetPinCommand.Execute(null))">@LanguageService["ok"]</MudButton>
					<MudButton Variant="Variant.Text" OnClick="@(() => ViewModel.CancelPinSetupCommand.Execute(null))">@LanguageService["cancel"]</MudButton>
				</MudStack>
			</MudPaper>
		}

		<MudText Typo="Typo.caption" Class="mb-1 mud-text-secondary">@ViewModel.CountText</MudText>

		@if (ViewModel.IsEmpty)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["password_empty"]</MudText>
		}
		else if (ViewModel.HasNoMatches)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["password_no_matches"]</MudText>
		}
		else
		{
			<div class="password-list">
				@foreach (var entry in ViewModel.FilteredEntries)
				{
					<MudPaper Elevation="1" Class="pa-2 my-2 password-card" @key="entry.Id">
						@if (ViewModel.IsEditingOf(entry))
						{
							<MudTextField @bind-Value="ViewModel.DraftName" Label="@LanguageService["password_name"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
							<MudTextField @bind-Value="ViewModel.DraftUsername" Label="@LanguageService["password_username"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" />
							<MudTextField @bind-Value="ViewModel.DraftPassword" Label="@LanguageService["password_password"]"
								Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1"
								InputType="@(ViewModel.ShowPassword ? InputType.Text : InputType.Password)"
								Adornment="Adornment.End"
								AdornmentIcon="@(ViewModel.ShowPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
								OnAdornmentClick="@(() => ViewModel.ShowPassword = !ViewModel.ShowPassword)" />
							<MudTextField @bind-Value="ViewModel.DraftUris" Label="@LanguageService["password_uris"]"
								Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" Lines="2"
								HelperText="@LanguageService["password_uris_hint"]" />
							<MudTextField @bind-Value="ViewModel.DraftTotpSecret" Label="@LanguageService["password_totp"]"
								Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1"
								HelperText="@LanguageService["password_totp_hint"]" />
							<MudTextField @bind-Value="ViewModel.DraftNotes" Label="@LanguageService["password_notes"]"
								Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" Lines="2" />
							<MudStack Row="true" Spacing="0" Class="mt-1">
								<MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small"
									OnClick="@(() => ViewModel.SaveEntryCommand.Execute(null))" title="@LanguageService["ok"]" />
								<MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
									OnClick="@(() => ViewModel.CancelEditCommand.Execute(null))" title="@LanguageService["cancel"]" />
							</MudStack>
						}
						else
						{
							<div class="d-flex align-center">
								<div class="flex-grow-1">
									<MudText Typo="Typo.subtitle1">@(string.IsNullOrWhiteSpace(entry.Name) ? LanguageService["password_unnamed"] : entry.Name)</MudText>
									@if (!string.IsNullOrWhiteSpace(entry.Username))
									{
										<MudText Typo="Typo.body2">@entry.Username</MudText>
									}
									@if (!string.IsNullOrWhiteSpace(entry.PrimaryUri))
									{
										<div class="password-uri">@entry.PrimaryUri</div>
									}
								</div>
								<MudStack Row="true" Spacing="0" Class="flex-shrink-0">
									<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
										OnClick="@(() => ViewModel.StartEditCommand.Execute(entry))" title="@LanguageService["password_edit"]" />
									<MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
										OnClick="@(() => ViewModel.DeleteCommand.Execute(entry))" title="@LanguageService["password_delete"]" />
								</MudStack>
							</div>
							<div class="d-flex align-center flex-wrap mt-1">
								@if (!string.IsNullOrEmpty(entry.Username))
								{
									<MudButton Size="Size.Small" Variant="Variant.Text"
										OnClick="@(() => ViewModel.CopyUsernameCommand.Execute(entry))">@LanguageService["password_copy_user"]</MudButton>
								}
								@if (!string.IsNullOrEmpty(entry.Password))
								{
									<MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
										OnClick="@(() => ViewModel.CopyPasswordCommand.Execute(entry))">@LanguageService["password_copy_pass"]</MudButton>
								}
								@if (entry.HasTotp && !string.IsNullOrEmpty(entry.TotpCode))
								{
									<MudButton Size="Size.Small" Variant="Variant.Text" Class="password-totp"
										OnClick="@(() => ViewModel.CopyTotpCommand.Execute(entry))"
										title="@LanguageService["password_copy_totp"]">
										@entry.TotpCode (@entry.TotpRemaining)
									</MudButton>
								}
							</div>
						}
					</MudPaper>
				}
			</div>
		}
	}
</div>

@code {
	[Parameter]
	public PasswordViewModel ViewModel { get; set; }

	private SecureStringConverter _secureStringConverter;
	private bool _passwordVisible;
	private Timer _totpTimer;

	private InputType _passwordInputType => _passwordVisible ? InputType.Text : InputType.Password;
	private string _passwordInputIcon => _passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

	protected override void OnInitialized()
	{
		_secureStringConverter = new SecureStringConverter();
		_totpTimer = new Timer(_ =>
		{
			if (ViewModel != null && ViewModel.IsUnlocked)
			{
				InvokeAsync(() =>
				{
					ViewModel.TickTotpCommand.Execute(null);
					StateHasChanged();
				});
			}
		}, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
	}

	public void Dispose()
	{
		_totpTimer?.Dispose();
		_totpTimer = null;
	}
}
