@using CommunityToolkit.Mvvm.Input
@using MudBlazor
@using SilentNotes.Services
@using SilentNotes.ViewModels

<style type="text/css">
	.abro-root {
		background-color: #000000;
		min-height: calc(100vh - 208px);
		padding: 16px;
		color: #ffffff;
	}
	.abro-card {
		border: 1px solid #2b2b2b;
		border-radius: 14px;
		background-color: #0d0d0d;
		padding: 16px;
	}
	.abro-desc {
		font-size: 0.85rem;
		color: #9e9e9e;
		margin: 8px 0 14px 0;
	}
	.abro-quick {
		display: flex;
		gap: 8px;
		margin-top: 12px;
		flex-wrap: wrap;
	}
	.abro-quick-btn {
		border: 1px solid #2b2b2b;
		border-radius: 10px;
		background-color: #000000;
		color: #ffffff;
		height: 36px;
		padding: 0 12px;
		font-size: 0.85rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.abro-quick-btn:active {
		background-color: #1f1f1f;
	}
</style>

<div class="abro-root">
	@if (ViewModel == null || !ViewModel.IsSupported)
	{
		<MudAlert Severity="Severity.Info" Dense="true">The Abro browser is not available on this platform.</MudAlert>
	}
	else
	{
		<div class="abro-card">
			<MudText Typo="Typo.h6">Abro</MudText>
			<div class="abro-desc">
				Light multi-tab web browser. History, cookies, cache and downloads are stored in
				the visible folder /sdcard/abro, open tabs are restored on start.
			</div>
			<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Language"
				OnClick="OpenBrowserAsync">Open browser</MudButton>
			<div class="abro-quick">
				<button class="abro-quick-btn" @onclick="OpenBookmarksAsync" title="Bookmarks">
					<MudIcon Icon="@Icons.Material.Filled.Bookmarks" Size="Size.Small" />
					<span>Bookmarks</span>
				</button>
				<button class="abro-quick-btn" @onclick="OpenHistoryAsync" title="History">
					<MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
					<span>History</span>
				</button>
			</div>
		</div>
	}
</div>

@code {
	[Parameter]
	public AbroViewModel ViewModel { get; set; }

	private bool _autoOpened;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_autoOpened && ViewModel != null && ViewModel.IsSupported)
		{
			_autoOpened = true;
			await OpenBrowserAsync();
		}
	}

	private async Task OpenBrowserAsync()
	{
		if (ViewModel == null)
			return;
		if (ViewModel.OpenBrowserCommand is IAsyncRelayCommand asyncCmd)
			await asyncCmd.ExecuteAsync(null);
		else
			ViewModel.OpenBrowserCommand.Execute(null);
	}

	private async Task OpenBookmarksAsync()
	{
		if (ViewModel == null)
			return;
		if (ViewModel.OpenBookmarksCommand is IAsyncRelayCommand asyncCmd)
			await asyncCmd.ExecuteAsync(null);
		else
			ViewModel.OpenBookmarksCommand.Execute(null);
	}

	private async Task OpenHistoryAsync()
	{
		if (ViewModel == null)
			return;
		if (ViewModel.OpenHistoryCommand is IAsyncRelayCommand asyncCmd)
			await asyncCmd.ExecuteAsync(null);
		else
			ViewModel.OpenHistoryCommand.Execute(null);
	}
}
