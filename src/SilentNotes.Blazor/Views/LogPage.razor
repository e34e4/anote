@attribute [Route(RouteNames.Log)]
@inherits PageBase

@using System.IO
@using System.Linq
@using MudBlazor
@using SilentNotes.Services
@using SilentNotes.Workers

@inject ILanguageService LanguageService
@inject ISvgIconService IconService
@inject INavigationService Navigation
@inject ISharingService SharingService
@inject IFeedbackService FeedbackService
@inject IJSRuntime JSRuntime

<style type="text/css">
	.log-scroll {
		overflow-y: auto;
		max-height: calc(100vh - 200px);
	}
	.log-path {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		opacity: 0.75;
		word-break: break-all;
	}
	.log-day {
		margin: 12px 0 6px;
		padding: 4px 8px;
		font-weight: 600;
		font-size: 0.85rem;
		border-left: 3px solid var(--mud-palette-primary);
		opacity: 0.9;
	}
	.log-line {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		padding: 5px 8px;
		margin-bottom: 3px;
		border-radius: 6px;
		border: 1px solid rgba(255,255,255,0.06);
		background: rgba(0,0,0,0.14);
	}
	.log-line-selected {
		border-color: var(--mud-palette-primary);
		background: rgba(56, 189, 248, 0.12);
	}
	.log-check {
		flex: 0 0 auto;
		width: 16px;
		height: 16px;
		margin-top: 2px;
		accent-color: var(--mud-palette-primary);
		cursor: pointer;
	}
	.log-meta {
		flex: 0 0 auto;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		opacity: 0.85;
		white-space: nowrap;
	}
	.log-page {
		flex: 0 0 auto;
		min-width: 64px;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 600;
	}
	.log-text {
		flex: 1 1 auto;
		min-width: 0;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.78rem;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		word-break: break-word;
		line-height: 1.35;
	}
	.log-D { color: #9e9e9e; }
	.log-I { color: #81d4fa; }
	.log-W { color: #ffb74d; }
	.log-E { color: #ef5350; }
	.log-badge {
		display: inline-block;
		padding: 1px 5px;
		border-radius: 4px;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		font-weight: 600;
		flex: 0 0 auto;
		white-space: nowrap;
	}
	.log-badge-kind {
		background: rgba(239, 83, 80, 0.22);
		color: #ff8a80;
		border: 1px solid rgba(239, 83, 80, 0.45);
	}
	.log-badge-sent {
		background: rgba(56, 189, 248, 0.18);
		color: #38bdf8;
		border: 1px solid rgba(56, 189, 248, 0.4);
	}
	.log-badge-unsent {
		background: rgba(148, 163, 184, 0.14);
		color: #94a3b8;
		border: 1px solid rgba(148, 163, 184, 0.3);
	}
</style>

<MudAppBar Class="flex-none" Fixed="true" Dense="true" WrapContent="false">
	<MudIconButton OnClick="@(() => Navigation.NavigateTo(BackRoute))" Icon="@IconService[IconNames.ArrowLeft]" Color="Color.Inherit" title="@LanguageService["back"]" Edge="Edge.Start" />
	<MudText Typo="Typo.h6">@LanguageService["show_log"]</MudText>
	<MudSpacer />
	<MudIconButton Icon="@Icons.Material.Filled.Email"
		Color="@(_selectedLineIndices.Count > 0 ? Color.Primary : Color.Inherit)"
		title="@(_selectedLineIndices.Count > 0 ? string.Format(LanguageService["log_email_selected"], _selectedLineIndices.Count) : LanguageService["log_email_unsent"])"
		OnClick="EmailUnsentErrorsAsync"
		Disabled="@(_loading || _emailing)" />
	<MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit" title="@LanguageService["log_refresh"]" OnClick="Refresh" Disabled="@(_loading || _emailing)" />
	<MudIconButton Icon="@Icons.Material.Filled.Share" Color="Color.Inherit" title="@LanguageService["log_share"]" OnClick="ShareLogAsync" Disabled="@(_loading || _emailing)" />
</MudAppBar>

<MudMainContent>
	<MudContainer Class="ms-0 px-2" MaxWidth="MaxWidth.Large">
		<div class="log-path pa-1">@AnotePaths.LogFile</div>

		<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 mt-1" Spacing="2" Style="flex-wrap:wrap">
			<MudCheckBox T="bool" Value="_errorsOnly" ValueChanged="OnErrorsOnlyChanged" Label="@LanguageService["log_errors_only"]" Color="Color.Error" Dense="true" />
			<MudSelect T="string" Dense="true" Margin="Margin.Dense" Label="@LanguageService["log_filter_page"]"
				Value="_pageFilter" ValueChanged="OnPageFilterChanged" Style="min-width:160px;max-width:240px">
				<MudSelectItem T="string" Value="@AllPagesValue">@LanguageService["log_all_pages"]</MudSelectItem>
				@foreach (string pageName in _pages)
				{
					<MudSelectItem T="string" Value="@pageName">@pageName</MudSelectItem>
				}
			</MudSelect>
			<MudText Typo="Typo.caption">@string.Format(LanguageService["log_matches"], _visible.Count)</MudText>
			@if (_selectedLineIndices.Count > 0)
			{
				<MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="ClearSelection">
					@string.Format(LanguageService["log_selected_count"], _selectedLineIndices.Count)
				</MudChip>
			}
		</MudStack>

		@if (_loading)
		{
			<MudProgressLinear Indeterminate="true" Class="mb-2" />
		}

		<div class="log-scroll pa-1">
			@if (_visible.Count == 0)
			{
				<MudAlert Severity="Severity.Info" Dense="true">@LanguageService["log_empty"]</MudAlert>
			}
			else
			{
				@foreach (AnoteLogEntry entry in _visible)
				{
					if (entry.IsDayHeader)
					{
						<div @key="entry.LineIndex" class="log-day">@entry.Day</div>
					}
					else
					{
						string sevCode = entry.SeverityCode;
						bool isSelected = _selectedLineIndices.Contains(entry.LineIndex);
						<div @key="entry.LineIndex" class="@($"log-line log-{sevCode}{(isSelected ? " log-line-selected" : string.Empty)}")">
							<input type="checkbox" class="log-check" checked="@isSelected"
								@onchange="@(e => ToggleSelection(entry.LineIndex, e.Value is bool b && b))" />
							<span class="log-meta">@(entry.Timestamp?.ToString("HH:mm:ss") ?? "--:--:--") [@sevCode]</span>
							<span class="log-page">@entry.Page</span>
							@if (entry.Severity == AnoteLogSeverity.Error)
							{
								<span class="log-badge log-badge-kind">@entry.ErrorKind</span>
								<span class="@(entry.EmailSent ? "log-badge log-badge-sent" : "log-badge log-badge-unsent")">
									@(entry.EmailSent ? "✉ sent" : "✉ unsent")
								</span>
							}
							<span class="log-text">@entry.Message</span>
						</div>
					}
				}
			}
		</div>
	</MudContainer>
</MudMainContent>

@code {
	private const string AllPagesValue = "";

	private bool _loading;
	private bool _emailing;
	private bool _errorsOnly;
	private string _pageFilter = AllPagesValue;
	private List<string> _pages = new();
	private List<AnoteLogEntry> _all = new();
	private List<AnoteLogEntry> _visible = new();
	private readonly HashSet<int> _selectedLineIndices = new();

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await KeyboardShortcuts.InitializeAsync(JSRuntime);
			KeyboardShortcuts
				.AddShortcut(new SnKeyboardShortcut(SnKey.Escape), () => Navigation.NavigateTo(BackRoute));
			Refresh();
		}
	}

	private Task OnErrorsOnlyChanged(bool value)
	{
		_errorsOnly = value;
		ApplyFilter();
		return Task.CompletedTask;
	}

	private Task OnPageFilterChanged(string value)
	{
		_pageFilter = value ?? AllPagesValue;
		ApplyFilter();
		return Task.CompletedTask;
	}

	private void Refresh()
	{
		_loading = true;
		try
		{
			_all = AnoteFileLog.ReadEntries().ToList();
			_pages = AnoteFileLog.ListPages(_all).ToList();
			var validIndices = new HashSet<int>(_all.Where(e => !e.IsDayHeader).Select(e => e.LineIndex));
			_selectedLineIndices.RemoveWhere(idx => !validIndices.Contains(idx));
			ApplyFilter(stateHasChanged: false);
		}
		finally
		{
			_loading = false;
			StateHasChanged();
		}
	}

	private void ApplyFilter(bool stateHasChanged = true)
	{
		IEnumerable<AnoteLogEntry> query = _all;
		if (_errorsOnly)
			query = query.Where(e => e.IsDayHeader || e.Severity == AnoteLogSeverity.Error);
		if (!string.IsNullOrEmpty(_pageFilter))
			query = query.Where(e => e.IsDayHeader || string.Equals(e.Page, _pageFilter, StringComparison.OrdinalIgnoreCase));

		var list = query.ToList();
		// Group by day, newest day first, newest entries first within each day.
		var groups = new List<(AnoteLogEntry Header, List<AnoteLogEntry> Items)>();
		(AnoteLogEntry Header, List<AnoteLogEntry> Items)? current = null;
		foreach (AnoteLogEntry e in list)
		{
			if (e.IsDayHeader)
			{
				if (current != null && current.Value.Items.Count > 0)
					groups.Add(current.Value);
				current = (e, new List<AnoteLogEntry>());
				continue;
			}

			if (current == null)
				current = (null, new List<AnoteLogEntry>());
			current.Value.Items.Add(e);
		}
		if (current != null && current.Value.Items.Count > 0)
			groups.Add(current.Value);

		groups.Reverse();
		var cleaned = new List<AnoteLogEntry>();
		foreach ((AnoteLogEntry header, List<AnoteLogEntry> items) in groups)
		{
			items.Reverse();
			if (header != null)
				cleaned.Add(header);
			cleaned.AddRange(items);
		}

		_visible = cleaned;
		if (stateHasChanged)
			StateHasChanged();
	}

	private async Task ShareLogAsync()
	{
		string path = AnotePaths.LogFile;
		if (!File.Exists(path))
		{
			FeedbackService.ShowToast(LanguageService["log_empty"]);
			return;
		}

		await SharingService.ShareFile(path, "text/plain");
	}

	private void ToggleSelection(int lineIndex, bool selected)
	{
		if (selected)
			_selectedLineIndices.Add(lineIndex);
		else
			_selectedLineIndices.Remove(lineIndex);
	}

	private void ClearSelection()
	{
		_selectedLineIndices.Clear();
	}

	private async Task EmailUnsentErrorsAsync()
	{
		if (_emailing)
			return;

		_emailing = true;
		StateHasChanged();
		try
		{
			List<AnoteLogEntry> selected = _selectedLineIndices.Count > 0
				? _all.Where(e => !e.IsDayHeader && _selectedLineIndices.Contains(e.LineIndex)).ToList()
				: null;

			AnoteFileLog.ErrorEmailFlushResult result = selected != null && selected.Count > 0
				? await AnoteFileLog.SendSelectedErrorEmailsAsync(selected)
				: await AnoteFileLog.SendUnsentErrorEmailsAsync();

			if (result.CandidateCount == 0)
			{
				FeedbackService.ShowToast(LanguageService["log_email_unsent_none"]);
			}
			else if (result.SentCount > 0 && result.FailedCount == 0)
			{
				if (selected != null)
					_selectedLineIndices.Clear();
				FeedbackService.ShowToast(string.Format(LanguageService["log_email_unsent_ok"], result.SentCount));
			}
			else if (result.SentCount > 0)
			{
				if (selected != null)
					_selectedLineIndices.Clear();
				FeedbackService.ShowToast(string.Format(
					LanguageService["log_email_unsent_partial"],
					result.SentCount,
					result.FailedCount));
			}
			else
			{
				FeedbackService.ShowToast(string.Format(
					LanguageService["log_email_unsent_fail"],
					result.Detail ?? "unknown"));
			}

			Refresh();
		}
		catch (Exception ex)
		{
			FeedbackService.ShowToast(string.Format(LanguageService["log_email_unsent_fail"], ex.Message));
		}
		finally
		{
			_emailing = false;
			StateHasChanged();
		}
	}
}
