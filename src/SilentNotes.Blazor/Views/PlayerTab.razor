@using CommunityToolkit.Mvvm.Input
@using MudBlazor
@using SilentNotes.Models
@using SilentNotes.Services
@using SilentNotes.ViewModels
@implements IDisposable

@inject ILanguageService LanguageService
@inject IMessengerService MessengerService
@inject IWebdavQuickSaveService WebdavQuickSaveService
@inject IWebdavFileService WebdavFileService
@inject IFeedbackService FeedbackService

<style type="text/css">
	.player-root {
		background-color: #000000;
		min-height: calc(100vh - 208px);
		padding: 10px;
		color: #ffffff;
	}
	.player-sticky-header {
		position: sticky;
		top: 0;
		z-index: 8;
		background-color: #000000;
	}
	.player-toolbar {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 2px 4px 10px 4px;
		border-bottom: 1px solid #202020;
		flex-wrap: wrap;
	}
	.player-path {
		font-family: ui-monospace, "Cascadia Code", monospace;
		font-size: 0.82rem;
		color: #cccccc;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		flex-grow: 1;
		min-width: 80px;
	}
	.player-roots {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
		padding: 8px 0;
	}
	.player-chip {
		border: 1px solid #2b2b2b;
		border-radius: 8px;
		background-color: #000000;
		color: #bdbdbd;
		font-size: 0.78rem;
		padding: 4px 10px;
		cursor: pointer;
		touch-action: manipulation;
	}
	.player-chip.active {
		border-color: var(--mud-palette-primary);
		color: var(--mud-palette-primary);
	}
	.player-now {
		border: 1px solid #2b2b2b;
		border-radius: 14px;
		background-color: #0d0d0d;
		padding: 12px 14px;
		margin-bottom: 12px;
	}
	.player-now-title {
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		margin-bottom: 6px;
	}
	.player-now-controls {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.player-now-time {
		font-family: ui-monospace, "Cascadia Code", monospace;
		font-size: 0.82rem;
		color: var(--mud-palette-primary);
		min-width: 96px;
	}
	.player-row {
		display: flex;
		align-items: flex-start;
		padding: 10px 6px;
		border-bottom: 1px solid #202020;
		gap: 8px;
		cursor: pointer;
	}
	.player-row:active {
		background-color: #151515;
	}
	.player-row.selected {
		background: rgba(36, 129, 204, 0.18);
	}
	.player-selection-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		padding: 4px 4px 10px 4px;
		border-bottom: 1px solid #202020;
		align-items: center;
	}
	.player-sel-btn {
		border: 1px solid #2b2b2b;
		border-radius: 10px;
		background-color: #0c0c0c;
		color: #ffffff;
		height: 34px;
		padding: 0 12px;
		font-size: 0.82rem;
		cursor: pointer;
	}
	.player-row-main {
		flex-grow: 1;
		overflow: hidden;
	}
	.player-row-name {
		font-weight: 600;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		white-space: normal;
		word-break: break-word;
	}
	.player-row-meta {
		font-size: 0.8rem;
		color: #9e9e9e;
	}
	.player-kind-icon {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background-color: #161616;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
</style>

<div class="player-root">
	@if (!ViewModel.IsSupported)
	{
		<MudAlert Severity="Severity.Info" Dense="true">@LanguageService["player_not_supported"]</MudAlert>
	}
	else
	{
		@if (ViewModel.NeedsPermission)
		{
			<MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
				<span>@LanguageService["player_needs_permission"]</span>
				<MudButton Size="Size.Small" Color="Color.Primary" Class="ml-2" OnClick="GrantPermissionAsync">@LanguageService["player_grant"]</MudButton>
			</MudAlert>
		}

		<div class="player-sticky-header">
			<div class="player-roots">
				@for (int i = 0; i < ViewModel.PathTabs.Count; i++)
				{
					int tabIndex = i;
					<button class="player-chip @(tabIndex == ViewModel.ActivePathTabIndex ? "active" : null)"
						@onclick="() => ViewModel.SelectPathTabCommand.Execute(tabIndex)"
						title="@(ViewModel.PathTabs[tabIndex].Path)">
						@(string.IsNullOrEmpty(ViewModel.PathTabs[tabIndex].Label) ? "/" : ViewModel.PathTabs[tabIndex].Label)
						@if (ViewModel.PathTabs.Count > 1)
						{
							<span @onclick:stopPropagation="true" @onclick="() => ViewModel.ClosePathTabCommand.Execute(tabIndex)"> ✕</span>
						}
					</button>
				}
				<button class="player-chip" @onclick="() => ViewModel.AddPathTabCommand.Execute(null)" title="@LanguageService["path_tab_add"]">+</button>
			</div>

			<div class="player-toolbar">
				@if (ViewModel.CanNavigateUp)
				{
					<MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Inherit"
						OnClick="() => ViewModel.NavigateUpCommand.Execute(null)" title="@LanguageService["player_up"]" />
				}
				<div class="player-path" title="@ViewModel.CurrentPathDisplay">@ViewModel.CurrentPathDisplay</div>
				<MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Color="Color.Primary"
					OnClick="PickFileAsync" title="@LanguageService["player_pick"]" />
				<MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Inherit"
					OnClick="() => ViewModel.RefreshCommand.Execute(null)" title="@LanguageService["player_refresh"]" />
			</div>

			<div class="player-roots" style="padding-top:0;padding-bottom:8px;border-bottom:1px solid #202020;">
				<button type="button" class="player-chip @(ViewModel.IsSortDate ? "active" : null)" @onclick='() => ViewModel.SetSortModeCommand.Execute("date")'>@LanguageService["browse_sort_date"]</button>
				<button type="button" class="player-chip @(ViewModel.IsSortName ? "active" : null)" @onclick='() => ViewModel.SetSortModeCommand.Execute("name")'>@LanguageService["browse_sort_name"]</button>
				<button type="button" class="player-chip @(ViewModel.IsSortSize ? "active" : null)" @onclick='() => ViewModel.SetSortModeCommand.Execute("size")'>@LanguageService["browse_sort_size"]</button>
			</div>

			@if (ViewModel.HasSelection)
			{
				<div class="player-selection-bar">
					<span>@ViewModel.SelectedCount</span>
					@if (ViewModel.CanRenameSelection)
					{
						<button type="button" class="player-sel-btn" @onclick="StartRenameSelected">@LanguageService["browse_rename"]</button>
					}
					<button type="button" class="player-sel-btn" @onclick="DeleteSelectedAsync">@LanguageService["delete"]</button>
					<button type="button" class="player-sel-btn" @onclick="SelectAllVisible">@LanguageService["list_select_all"]</button>
					<button type="button" class="player-sel-btn" @onclick="ClearSelection">@LanguageService["file_clear_selection"]</button>
				</div>
			}

			@if (ViewModel.IsRenameOpen)
			{
				<div class="d-flex align-center gap-2 px-1 py-2" style="border-bottom:1px solid #202020;">
					<MudTextField T="string" @bind-Value="ViewModel.RenameDraft" Placeholder="@LanguageService["browse_rename"]"
						Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Immediate="true" />
					<MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" OnClick="ConfirmRenameAsync" />
					<MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelRename" />
				</div>
			}
		</div>

		<div class="player-toolbar">
			<MudTextField T="string" @bind-Value="ViewModel.UrlDraft" Placeholder="@LanguageService["player_url_hint"]"
				Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Immediate="true" />
			<MudMenu Icon="@Icons.Material.Filled.History" Color="Color.Inherit"
				Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
				title="@LanguageService["player_url_history"]">
				@if (ViewModel.UrlHistory.Count == 0)
				{
					<MudMenuItem Disabled="true">@LanguageService["player_url_history_empty"]</MudMenuItem>
				}
				else
				{
					@foreach (string histUrl in ViewModel.UrlHistory)
					{
						string captured = histUrl;
						<MudMenuItem OnClick="() => OnHistoryUrlClick(captured)">
							<span style="max-width:280px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@captured</span>
						</MudMenuItem>
					}
				}
			</MudMenu>
			<MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary"
				OnClick="() => ViewModel.OpenUrlCommand.Execute(null)" title="@LanguageService["player_open_url"]" />
		</div>

		<div class="player-roots">
			@foreach (var root in ViewModel.StorageRoots)
			{
				<button class="player-chip" @onclick="() => ViewModel.GoToRootCommand.Execute(root.Key)">@root.Label</button>
			}
		</div>

		<div class="player-roots">
			<button class="player-chip @(ViewModel.IsKindAll ? "active" : null)" @onclick='() => ViewModel.SetKindFilterCommand.Execute("all")'>@LanguageService["player_filter_all"]</button>
			<button class="player-chip @(ViewModel.IsKindAudio ? "active" : null)" @onclick='() => ViewModel.SetKindFilterCommand.Execute("audio")'>@LanguageService["player_filter_audio"]</button>
			<button class="player-chip @(ViewModel.IsKindVideo ? "active" : null)" @onclick='() => ViewModel.SetKindFilterCommand.Execute("video")'>@LanguageService["player_filter_video"]</button>
			<button class="player-chip @(ViewModel.IsKindImage ? "active" : null)" @onclick='() => ViewModel.SetKindFilterCommand.Execute("image")'>@LanguageService["player_filter_image"]</button>
		</div>

		@if (ViewModel.HasActiveMedia && ViewModel.ActiveKind == MediaKind.Audio)
		{
			<div class="player-now">
				<div class="player-now-title">@ViewModel.ActiveTitle</div>
				<div class="player-now-controls">
					<MudIconButton Icon="@(ViewModel.IsPlaying ? Icons.Material.Filled.PauseCircleFilled : Icons.Material.Filled.PlayCircleFilled)"
						Color="Color.Primary" Size="Size.Medium"
						OnClick="() => ViewModel.TogglePlayCommand.Execute(null)" />
					<MudIconButton Icon="@Icons.Material.Filled.SkipPrevious" Size="Size.Small" Color="Color.Inherit"
						OnClick="() => ViewModel.PlayPreviousCommand.Execute(null)" title="@LanguageService["player_previous"]" />
					<MudIconButton Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small" Color="Color.Inherit"
						OnClick="() => ViewModel.PlayNextCommand.Execute(null)" title="@LanguageService["player_next"]" />
					<MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small" Color="Color.Inherit"
						OnClick="() => ViewModel.StopCommand.Execute(null)" />
					<span class="player-now-time">@ViewModel.PlaybackProgressText</span>
				</div>
				<MudSlider T="double" Value="@ViewModel.PlaybackRelative" ValueChanged="OnSeek" Min="0" Max="1" Step="0.001" Color="Color.Primary" Class="mt-1" />
				<div class="player-roots" style="padding-top:2px;">
					@foreach (double speed in SpeedOptions)
					{
						double capturedSpeed = speed;
						<button class="player-chip @(ViewModel.IsSpeed(capturedSpeed) ? "active" : null)"
							@onclick="() => ViewModel.SetSpeedCommand.Execute(capturedSpeed)">@FormatSpeed(capturedSpeed)</button>
					}
				</div>
			</div>
		}

		<div class="player-roots">
			<button class="player-chip" @onclick="() => ViewModel.QueueFolderCommand.Execute(null)">@LanguageService["player_queue_folder"]</button>
			@if (ViewModel.HasQueue)
			{
				<button class="player-chip" @onclick="() => ViewModel.PlayPreviousCommand.Execute(null)">◀ @LanguageService["player_previous"]</button>
				<button class="player-chip" @onclick="() => ViewModel.PlayNextCommand.Execute(null)">@LanguageService["player_next"] ▶</button>
				<button class="player-chip" @onclick="() => ViewModel.ClearQueueCommand.Execute(null)">@LanguageService.LoadTextFmt("player_queue_clear_fmt", ViewModel.QueueCount)</button>
			}
		</div>

		<MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@ViewModel.CountText</MudText>

		@if (ViewModel.IsBusy)
		{
			<div class="d-flex justify-center align-center pa-8">
				<MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
			</div>
		}
		else if (ViewModel.NeedsPermission && ViewModel.IsEmpty)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["player_needs_permission"]</MudText>
		}
		else if (ViewModel.IsEmpty)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["player_empty"]</MudText>
		}
		else if (ViewModel.HasNoMatches)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["player_no_matches"]</MudText>
		}
		else
		{
			@foreach (var item in ViewModel.FilteredItems)
			{
				<div class="player-row @(ViewModel.IsSelected(item) ? "selected" : null)" @key="item.Path">
					<MudCheckBox T="bool" Dense="true" Value="@ViewModel.IsSelected(item)"
						ValueChanged="@((bool _) => ToggleSelection(item))" @onclick:stopPropagation="true" />
					<div class="player-kind-icon" @onclick="() => OpenItemAsync(item)">
						<MudIcon Icon="@GetKindIcon(item.Kind)" Size="Size.Small" Color="Color.Inherit" />
					</div>
					<div class="player-row-main" @onclick="() => OpenItemAsync(item)">
						<div class="player-row-name">@item.Name</div>
						<div class="player-row-meta">@item.MetaText</div>
					</div>
					@if (item.Kind != MediaKind.Folder)
					{
						<MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Success" Size="Size.Small"
							OnClick="() => SaveFileToWebdavAsync(item)" title="@LanguageService["webdav_quick_save"]" />
						<MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small"
							OnClick="() => ShareFileAsync(item)" title="@LanguageService["share"]" />
					}
					else
					{
						<MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" @onclick="() => OpenItemAsync(item)" />
					}
				</div>
			}
		}
	}
</div>

@code {
	private static readonly double[] SpeedOptions = { 0.75, 1.0, 1.25, 1.5, 2.0 };

	[Parameter]
	public PlayerViewModel ViewModel { get; set; }

	private static string FormatSpeed(double speed)
	{
		return speed.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "x";
	}

	protected override void OnInitialized()
	{
		if (ViewModel != null)
			ViewModel.StateChanged += OnViewModelStateChanged;
		MessengerService.Register<AfterResumeMessage>(this, (r, m) => InvokeAsync(() =>
		{
			ViewModel?.Reload();
			StateHasChanged();
		}));
	}

	private void OnHistoryUrlClick(string url)
	{
		ViewModel?.ApplyHistoryUrl(url);
		StateHasChanged();
	}

	private void OnViewModelStateChanged()
	{
		InvokeAsync(StateHasChanged);
	}

	private async Task GrantPermissionAsync()
	{
		await ViewModel.GrantPermissionAsync();
		StateHasChanged();
	}

	private async Task PickFileAsync()
	{
		if (ViewModel.PickFileCommand is IAsyncRelayCommand asyncCmd)
			await asyncCmd.ExecuteAsync(null);
		else
			ViewModel.PickFileCommand.Execute(null);
		StateHasChanged();
	}

	private void ToggleSelection(MediaItemViewModel item)
	{
		ViewModel.ToggleSelection(item);
		StateHasChanged();
	}

	private void SelectAllVisible()
	{
		ViewModel.SelectAllVisible();
		StateHasChanged();
	}

	private void ClearSelection()
	{
		ViewModel.ClearSelection();
		StateHasChanged();
	}

	private async Task DeleteSelectedAsync()
	{
		await ViewModel.DeleteSelectedAsync();
		StateHasChanged();
	}

	private void StartRenameSelected()
	{
		ViewModel.StartRenameSelectedCommand.Execute(null);
		StateHasChanged();
	}

	private void CancelRename()
	{
		ViewModel.CancelRenameCommand.Execute(null);
		StateHasChanged();
	}

	private async Task ConfirmRenameAsync()
	{
		if (ViewModel.ConfirmRenameCommand is IAsyncRelayCommand asyncCmd)
			await asyncCmd.ExecuteAsync(null);
		else
			ViewModel.ConfirmRenameCommand.Execute(null);
		StateHasChanged();
	}

	private async Task OpenItemAsync(MediaItemViewModel item)
	{
		if (ViewModel.EnterItemCommand is IAsyncRelayCommand<MediaItemViewModel> asyncCmd)
			await asyncCmd.ExecuteAsync(item);
		else
			ViewModel.EnterItemCommand.Execute(item);
		StateHasChanged();
	}

	private void OnSeek(double value)
	{
		ViewModel.SeekCommand.Execute(value);
	}

	private async Task SaveFileToWebdavAsync(MediaItemViewModel item)
	{
		if (item == null || item.Kind == MediaKind.Folder)
			return;
		if (!WebdavQuickSaveService.IsConfigured)
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_not_configured"], FeedbackSeverity.Warning);
			return;
		}
		if (string.IsNullOrWhiteSpace(item.Path) || !System.IO.File.Exists(item.Path))
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"], FeedbackSeverity.Warning);
			return;
		}

		bool ok = await WebdavQuickSaveService.SaveLocalFileAsync("Player", item.Path);
		if (ok)
			FeedbackService.ShowToast(LanguageService.LoadTextFmt("webdav_quick_saved", WebdavQuickSaveService.LastFileName));
		else
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"] + " — " + WebdavQuickSaveService.LastError, FeedbackSeverity.Warning);
	}

	private async Task ShareFileAsync(MediaItemViewModel item)
	{
		if (item == null || item.Kind == MediaKind.Folder)
			return;
		if (string.IsNullOrWhiteSpace(item.Path) || !System.IO.File.Exists(item.Path))
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"], FeedbackSeverity.Warning);
			return;
		}

		byte[] content = await System.IO.File.ReadAllBytesAsync(item.Path);
		bool ok = await WebdavFileService.ShareDownloadedFileAsync(item.Name, content);
		if (!ok)
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"], FeedbackSeverity.Warning);
	}

	private static string GetKindIcon(MediaKind kind)
	{
		return kind switch
		{
			MediaKind.Folder => Icons.Material.Filled.Folder,
			MediaKind.Audio => Icons.Material.Filled.AudioFile,
			MediaKind.Video => Icons.Material.Filled.Movie,
			MediaKind.Image => Icons.Material.Filled.Image,
			_ => Icons.Material.Filled.InsertDriveFile,
		};
	}

	public void Dispose()
	{
		if (ViewModel != null)
			ViewModel.StateChanged -= OnViewModelStateChanged;
		MessengerService.Unregister<AfterResumeMessage>(this);
	}
}
