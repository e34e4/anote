@using CommunityToolkit.Mvvm.Input
@using MudBlazor
@using SilentNotes.Models
@using SilentNotes.Services
@using SilentNotes.ViewModels
@implements IDisposable

@inject ILanguageService LanguageService
@inject IMessengerService MessengerService
@inject IWebdavQuickSaveService WebdavQuickSaveService
@inject IWebdavFileService WebdavFileService
@inject IFeedbackService FeedbackService

<style type="text/css">
	.player-root {
		background-color: #000000;
		min-height: calc(100vh - 208px);
		padding: 10px;
		color: #ffffff;
	}
	.player-toolbar {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 2px 4px 10px 4px;
		border-bottom: 1px solid #202020;
		flex-wrap: wrap;
	}
	.player-path {
		font-family: ui-monospace, "Cascadia Code", monospace;
		font-size: 0.82rem;
		color: #cccccc;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		flex-grow: 1;
		min-width: 80px;
	}
	.player-roots {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
		padding: 8px 0;
	}
	.player-chip {
		border: 1px solid #2b2b2b;
		border-radius: 8px;
		background-color: #000000;
		color: #bdbdbd;
		font-size: 0.78rem;
		padding: 4px 10px;
		cursor: pointer;
		touch-action: manipulation;
	}
	.player-chip.active {
		border-color: var(--mud-palette-primary);
		color: var(--mud-palette-primary);
	}
	.player-now {
		border: 1px solid #2b2b2b;
		border-radius: 14px;
		background-color: #0d0d0d;
		padding: 12px 14px;
		margin-bottom: 12px;
	}
	.player-now-title {
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		margin-bottom: 6px;
	}
	.player-now-controls {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.player-now-time {
		font-family: ui-monospace, "Cascadia Code", monospace;
		font-size: 0.82rem;
		color: var(--mud-palette-primary);
		min-width: 96px;
	}
	.player-row {
		display: flex;
		align-items: center;
		padding: 10px 6px;
		border-bottom: 1px solid #202020;
		gap: 8px;
		cursor: pointer;
	}
	.player-row:active {
		background-color: #151515;
	}
	.player-row-main {
		flex-grow: 1;
		overflow: hidden;
	}
	.player-row-name {
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.player-row-meta {
		font-size: 0.8rem;
		color: #9e9e9e;
	}
	.player-kind-icon {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background-color: #161616;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
</style>

<div class="player-root">
	@if (!ViewModel.IsSupported)
	{
		<MudAlert Severity="Severity.Info" Dense="true">@LanguageService["player_not_supported"]</MudAlert>
	}
	else
	{
		@if (ViewModel.NeedsPermission)
		{
			<MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
				<span>@LanguageService["player_needs_permission"]</span>
				<MudButton Size="Size.Small" Color="Color.Primary" Class="ml-2" OnClick="GrantPermissionAsync">@LanguageService["player_grant"]</MudButton>
			</MudAlert>
		}

		<div class="player-toolbar">
			@if (ViewModel.CanNavigateUp)
			{
				<MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Inherit"
					OnClick="() => ViewModel.NavigateUpCommand.Execute(null)" title="@LanguageService["player_up"]" />
			}
			<div class="player-path" title="@ViewModel.CurrentPathDisplay">@ViewModel.CurrentPathDisplay</div>
			<MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Color="Color.Primary"
				OnClick="PickFileAsync" title="@LanguageService["player_pick"]" />
			<MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Inherit"
				OnClick="() => ViewModel.RefreshCommand.Execute(null)" title="@LanguageService["player_refresh"]" />
		</div>

		<div class="player-roots">
			@foreach (var root in ViewModel.StorageRoots)
			{
				<button class="player-chip" @onclick="() => ViewModel.GoToRootCommand.Execute(root.Key)">@root.Label</button>
			}
		</div>

		<div class="player-roots">
			<button class="player-chip @(ViewModel.IsKindAll ? "active" : null)" @onclick='() => ViewModel.SetKindFilterCommand.Execute("all")'>@LanguageService["player_filter_all"]</button>
			<button class="player-chip @(ViewModel.IsKindAudio ? "active" : null)" @onclick='() => ViewModel.SetKindFilterCommand.Execute("audio")'>@LanguageService["player_filter_audio"]</button>
			<button class="player-chip @(ViewModel.IsKindVideo ? "active" : null)" @onclick='() => ViewModel.SetKindFilterCommand.Execute("video")'>@LanguageService["player_filter_video"]</button>
			<button class="player-chip @(ViewModel.IsKindImage ? "active" : null)" @onclick='() => ViewModel.SetKindFilterCommand.Execute("image")'>@LanguageService["player_filter_image"]</button>
		</div>

		@if (ViewModel.HasActiveMedia && ViewModel.ActiveKind == MediaKind.Audio)
		{
			<div class="player-now">
				<div class="player-now-title">@ViewModel.ActiveTitle</div>
				<div class="player-now-controls">
					<MudIconButton Icon="@(ViewModel.IsPlaying ? Icons.Material.Filled.PauseCircleFilled : Icons.Material.Filled.PlayCircleFilled)"
						Color="Color.Primary" Size="Size.Medium"
						OnClick="() => ViewModel.TogglePlayCommand.Execute(null)" />
					<MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small" Color="Color.Inherit"
						OnClick="() => ViewModel.StopCommand.Execute(null)" />
					<span class="player-now-time">@ViewModel.PlaybackProgressText</span>
				</div>
				<MudSlider T="double" Value="@ViewModel.PlaybackRelative" ValueChanged="OnSeek" Min="0" Max="1" Step="0.001" Color="Color.Primary" Class="mt-1" />
			</div>
		}

		<MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@ViewModel.CountText</MudText>

		@if (ViewModel.IsBusy)
		{
			<div class="d-flex justify-center align-center pa-8">
				<MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
			</div>
		}
		else if (ViewModel.NeedsPermission && ViewModel.IsEmpty)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["player_needs_permission"]</MudText>
		}
		else if (ViewModel.IsEmpty)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["player_empty"]</MudText>
		}
		else if (ViewModel.HasNoMatches)
		{
			<MudText Align="Align.Center" Class="ma-8 mud-text-secondary">@LanguageService["player_no_matches"]</MudText>
		}
		else
		{
			@foreach (var item in ViewModel.FilteredItems)
			{
				<div class="player-row" @key="item.Path">
					<div class="player-kind-icon" @onclick="() => OpenItemAsync(item)">
						<MudIcon Icon="@GetKindIcon(item.Kind)" Size="Size.Small" Color="Color.Inherit" />
					</div>
					<div class="player-row-main" @onclick="() => OpenItemAsync(item)">
						<div class="player-row-name">@item.Name</div>
						<div class="player-row-meta">@item.MetaText</div>
					</div>
					@if (item.Kind != MediaKind.Folder)
					{
						<MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Success" Size="Size.Small"
							OnClick="() => SaveFileToWebdavAsync(item)" title="@LanguageService["webdav_quick_save"]" />
						<MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small"
							OnClick="() => ShareFileAsync(item)" title="@LanguageService["share"]" />
					}
					else
					{
						<MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" @onclick="() => OpenItemAsync(item)" />
					}
				</div>
			}
		}
	}
</div>

@code {
	[Parameter]
	public PlayerViewModel ViewModel { get; set; }

	protected override void OnInitialized()
	{
		if (ViewModel != null)
			ViewModel.StateChanged += OnViewModelStateChanged;
		MessengerService.Register<AfterResumeMessage>(this, (r, m) => InvokeAsync(() =>
		{
			ViewModel?.Reload();
			StateHasChanged();
		}));
	}

	private void OnViewModelStateChanged()
	{
		InvokeAsync(StateHasChanged);
	}

	private async Task GrantPermissionAsync()
	{
		await ViewModel.GrantPermissionAsync();
		StateHasChanged();
	}

	private async Task PickFileAsync()
	{
		if (ViewModel.PickFileCommand is IAsyncRelayCommand asyncCmd)
			await asyncCmd.ExecuteAsync(null);
		else
			ViewModel.PickFileCommand.Execute(null);
		StateHasChanged();
	}

	private async Task OpenItemAsync(MediaItemViewModel item)
	{
		if (ViewModel.EnterItemCommand is IAsyncRelayCommand<MediaItemViewModel> asyncCmd)
			await asyncCmd.ExecuteAsync(item);
		else
			ViewModel.EnterItemCommand.Execute(item);
		StateHasChanged();
	}

	private void OnSeek(double value)
	{
		ViewModel.SeekCommand.Execute(value);
	}

	private async Task SaveFileToWebdavAsync(MediaItemViewModel item)
	{
		if (item == null || item.Kind == MediaKind.Folder)
			return;
		if (!WebdavQuickSaveService.IsConfigured)
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_not_configured"], FeedbackSeverity.Warning);
			return;
		}
		if (string.IsNullOrWhiteSpace(item.Path) || !System.IO.File.Exists(item.Path))
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"], FeedbackSeverity.Warning);
			return;
		}

		bool ok = await WebdavQuickSaveService.SaveLocalFileAsync("Player", item.Path);
		if (ok)
			FeedbackService.ShowToast(LanguageService.LoadTextFmt("webdav_quick_saved", WebdavQuickSaveService.LastFileName));
		else
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"] + " — " + WebdavQuickSaveService.LastError, FeedbackSeverity.Warning);
	}

	private async Task ShareFileAsync(MediaItemViewModel item)
	{
		if (item == null || item.Kind == MediaKind.Folder)
			return;
		if (string.IsNullOrWhiteSpace(item.Path) || !System.IO.File.Exists(item.Path))
		{
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"], FeedbackSeverity.Warning);
			return;
		}

		byte[] content = await System.IO.File.ReadAllBytesAsync(item.Path);
		bool ok = await WebdavFileService.ShareDownloadedFileAsync(item.Name, content);
		if (!ok)
			FeedbackService.ShowToast(LanguageService["webdav_quick_save_failed"], FeedbackSeverity.Warning);
	}

	private static string GetKindIcon(MediaKind kind)
	{
		return kind switch
		{
			MediaKind.Folder => Icons.Material.Filled.Folder,
			MediaKind.Audio => Icons.Material.Filled.AudioFile,
			MediaKind.Video => Icons.Material.Filled.Movie,
			MediaKind.Image => Icons.Material.Filled.Image,
			_ => Icons.Material.Filled.InsertDriveFile,
		};
	}

	public void Dispose()
	{
		if (ViewModel != null)
			ViewModel.StateChanged -= OnViewModelStateChanged;
		MessengerService.Unregister<AfterResumeMessage>(this);
	}
}
